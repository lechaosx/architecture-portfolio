---
import { pageLanguage } from '../locale';
import { bindOneLetterWords } from '../one-letter-words';
import { canSplitProse } from '../prose';

const lang = pageLanguage(Astro.url.pathname);

// Pages CMS writes one typed line break as a single newline and two as
// a blank line; the architect starts a paragraph with either.
interface Props {
  cs?: string;
  en?: string;
  class: string;
}

const { cs, en, class: cls } = Astro.props;
const languages = [
  { lang: 'cs', text: cs && bindOneLetterWords(cs.trim()) },
  { lang: 'en', text: en?.trim() },
];
---

{
  languages.filter((entry) => entry.lang === lang).map(
    ({ lang, text }) =>
      text && (
        <div {lang} class:list={['running-text', cls, { 'prose-columns': canSplitProse(text) }]}>
          {text.split(/\s*\n\s*/).map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ),
  )
}
