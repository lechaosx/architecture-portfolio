---
import { pageLanguage } from '../locale';
import { bindOneLetterWords } from '../one-letter-words';
import { canSplitProse } from '../prose';

const lang = pageLanguage(Astro.url.pathname);

// Pages CMS writes one typed line break as a single newline and two as
// a blank line; the architect starts a paragraph with either.
interface Props {
  cs?: string;
  en?: string;
  class: string;
}

const { cs, en, class: cls } = Astro.props;
const texts = { cs: cs ? bindOneLetterWords(cs.trim()) : '', en: en?.trim() ?? '' };
const text = texts[lang];
---

<div
  {lang}
  hidden={!text}
  data-translation-paragraphs
  data-translation-optional
  data-translation-cs={texts.cs} data-translation-en={texts.en}
  data-columns-cs={canSplitProse(texts.cs)} data-columns-en={canSplitProse(texts.en)}
  class:list={['running-text', cls, { 'prose-columns': canSplitProse(text) }]}
>
  {text && text.split(/\s*\n\s*/).map((paragraph) => <p>{paragraph}</p>)}
</div>
