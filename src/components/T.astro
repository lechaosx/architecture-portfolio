---
import { pageLanguage } from '../locale';
import { ui, type UiKey } from '../i18n';
import { bindOneLetterWords } from '../one-letter-words';
import type { HTMLTag } from 'astro/types';

const lang = pageLanguage(Astro.url.pathname);

interface Props {
  bilingual?: boolean;
  k?: UiKey;
  cs?: string;
  en?: string;
  as?: HTMLTag;
  class?: string;
}

const { bilingual = false, k, cs, en, as = 'span', class: cls } = Astro.props;
const csText = bindOneLetterWords(k ? ui.cs[k] : (cs ?? ''));
const enText = k ? ui.en[k] : (en ?? '');
const Tag = as;
---

{(bilingual ? ['cs', 'en'] as const : [lang]).map((language) => <Tag lang={language} class={cls} data-translation-cs={bilingual ? undefined : csText} data-translation-en={bilingual ? undefined : enText} set:text={language === 'cs' ? csText : enText} />)}
