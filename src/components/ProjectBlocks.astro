---
import type { CollectionEntry } from 'astro:content';
import Carousel from './Carousel.astro';
import Prose from './Prose.astro';
import T from './T.astro';
import { imageText } from './gallery';
import { ui } from '../i18n';
import {
  coverSizes,
  displayImageUrl,
  LARGE_IMAGE_WIDTHS,
  responsiveSrcset,
  THUMBNAIL_WIDTHS,
} from '../images';
import type { ResponsiveImage } from '../images';

type ProjectBlock = CollectionEntry<'projects'>['data']['blocks'][number];

interface Props {
  projectId: string;
  blocks: ProjectBlock[];
  responsiveImages: (ResponsiveImage | undefined)[];
}

const { projectId, blocks, responsiveImages } = Astro.props;
let pageImageIndex = 0;
const displayBlocks = blocks.map((block, blockIndex) =>
  block.type === 'text'
    ? block
    : {
        ...block,
        images: block.images.map((item) => {
          const index = pageImageIndex++;
          return {
            item,
            index,
            responsive: responsiveImages[index],
            // The alt text: Czech as served, then set from data-cs/data-en
            // by the language script in Base.astro.
            title: {
              cs: imageText(item, 'title', 'cs'),
              en: imageText(item, 'title', 'en'),
            },
            loading: index === 0 ? 'eager' : 'lazy',
            decoding: index === 0 ? 'auto' : 'async',
            // Only an image at the top of the page morphs from the work card.
            morph: blockIndex === 0 && index === 0,
          } as const;
        }),
      },
);
const morphName = `view-transition-name: cover-${projectId}`;
---

<div class="flex flex-col gap-12">
  {
    displayBlocks.map((block) => {
      if (block.type === 'text') {
        return (
          <Prose
            cs={block.body_cs}
            en={block.body_en}
          />
        );
      }

      if (block.type === 'gallery') {
        return (
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {block.images.map(({ item, index, responsive, title, loading, decoding, morph }) => {
              const aspectRatio = responsive
                ? responsive.source.width / responsive.source.height
                : 1;
              return (
                <button
                  type="button"
                  data-lightbox-index={index}
                  class:list={[
                    'group aspect-square overflow-hidden bg-neutral-100',
                    { 'project-cover': morph },
                  ]}
                  style={morph ? morphName : undefined}
                >
                  <T
                    cs={`${ui.cs.openImage} ${index + 1}`}
                    en={`${ui.en.openImage} ${index + 1}`}
                    class="sr-only"
                  />
                  <img
                    src={displayImageUrl(responsive, item.image)}
                    srcset={responsiveSrcset(responsive, THUMBNAIL_WIDTHS)}
                    sizes={coverSizes(
                      aspectRatio,
                      1,
                      [
                        { media: '(min-width: 1152px)', fixed: 360 },
                        {
                          media: '(min-width: 640px)',
                          viewport: 100 / 3,
                          gutter: 24,
                        },
                        { viewport: 50, gutter: 30 },
                      ],
                      1.05,
                    )}
                    alt={title.cs ?? ''}
                    data-cs={title.cs}
                    data-en={title.en}
                    {loading}
                    {decoding}
                    class="size-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-105"
                  />
                </button>
              );
            })}
          </div>
        );
      }

      if (block.images.length === 1) {
        const [{ item, index, responsive, title, loading, decoding, morph }] = block.images;
        return (
          <button
            type="button"
            data-lightbox-index={index}
            class:list={[
              'group block w-full overflow-hidden bg-neutral-100',
              { 'project-cover': morph },
            ]}
            style={morph ? morphName : undefined}
          >
            <T
              cs={`${ui.cs.openImage} ${index + 1}`}
              en={`${ui.en.openImage} ${index + 1}`}
              class="sr-only"
            />
            <img
              src={displayImageUrl(responsive, item.image)}
              srcset={responsiveSrcset(responsive, LARGE_IMAGE_WIDTHS)}
              sizes="(min-width: 1152px) 1104px, calc(100vw - 48px)"
              width={responsive?.source.width}
              height={responsive?.source.height}
              alt={title.cs ?? ''}
              data-cs={title.cs}
              data-en={title.en}
              {loading}
              {decoding}
              class="w-full motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-102"
            />
          </button>
        );
      }

      return (
        <Carousel items={block.images}>
          {({ item, index, responsive, title, loading, decoding, morph }: (typeof block.images)[number]) => (
            <button
              type="button"
              data-lightbox-index={index}
              class:list={{ 'project-cover': morph }}
              style={morph ? morphName : undefined}
            >
              <T
                cs={`${ui.cs.openImage} ${index + 1}`}
                en={`${ui.en.openImage} ${index + 1}`}
                class="sr-only"
              />
              <img
                src={displayImageUrl(responsive, item.image)}
                srcset={responsiveSrcset(responsive, LARGE_IMAGE_WIDTHS)}
                sizes="(min-width: 1152px) 1104px, calc(100vw - 48px)"
                width={responsive?.source.width}
                height={responsive?.source.height}
                alt={title.cs ?? ''}
                data-cs={title.cs}
                data-en={title.en}
                {loading}
                {decoding}
                class="size-full object-contain"
              />
            </button>
          )}
        </Carousel>
      );
    })
  }
</div>

