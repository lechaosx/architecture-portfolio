---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Carousel from './Carousel.astro';
import ContactCard from './ContactCard.astro';
import ProjectGrid from './ProjectGrid.astro';
import SectionHeading from './SectionHeading.astro';
import T from './T.astro';
import { credentialedName } from '../site-title';
import { ui } from '../i18n';
import { workProjects, type Project } from '../projects';
import { getResponsiveImage } from '../server-images';
import {
  coverSizes,
  displayImageUrl,
  LARGE_IMAGE_WIDTHS,
  responsiveSrcset,
} from '../images';
import { webSite } from '../structured-data';

interface Props {
  landing: CollectionEntry<'landing'>['data'];
  projects: Project[];
  about: CollectionEntry<'about'>['data'];
  contact: CollectionEntry<'contact'>['data'];
}

const { landing, projects, about, contact } = Astro.props;
// Each language's line is built whole, so a place filled in one language
// leaves no stray separator in the other.
const identity = (lang: 'cs' | 'en') =>
  [ui[lang].tagline, contact[`location_${lang}`]?.trim()].filter(Boolean).join(' · ');
const services = (lang: 'cs' | 'en') =>
  about.services.map((service) => service[`name_${lang}`]).join(' · ');
const heroImages = await Promise.all(
  landing.images.map(async (src) => ({ src, responsive: await getResponsiveImage(src) })),
);
const selected = workProjects(projects).grid.slice(0, 3);
// Social sites show no SVG and an SVG has no share JPEG, so the first raster
// image is shared, else the newest cover.
const image =
  heroImages.find(({ responsive }) => responsive)?.responsive?.share ??
  (selected[0] && (await getResponsiveImage(selected[0].cover.image))?.share);
---

<Base
  title={{
    cs: `${credentialedName} | ${ui.cs.tagline}`,
    en: `${credentialedName} | ${ui.en.tagline}`,
  }}
  {image}
  graph={[webSite({ site: new URL('/', Astro.site), name: credentialedName })]}
>
  {/* The hero sits closer under the header than a page heading does; without
      it the identity line opens the page like one. */}
  <div
    class:list={[
      'mx-auto max-w-6xl px-6 pb-16 sm:pb-24',
      heroImages.length > 0 ? 'pt-8' : 'pt-12 sm:pt-16',
    ]}
  >
    {
      heroImages.length === 1 ? (
        <img
          src={displayImageUrl(heroImages[0].responsive, heroImages[0].src)}
          srcset={responsiveSrcset(heroImages[0].responsive, LARGE_IMAGE_WIDTHS)}
          sizes="(min-width: 1152px) 1104px, calc(100vw - 48px)"
          width={heroImages[0].responsive?.source.width}
          height={heroImages[0].responsive?.source.height}
          alt=""
          loading="eager"
          decoding="async"
          class="w-full bg-neutral-100"
        />
      ) : heroImages.length > 1 && (
        <Carousel items={heroImages} autoAdvance>
          {({ src, responsive }: (typeof heroImages)[number], index: number) => (
            <div role="group">
              <T
                cs={`${index + 1} ${ui.cs.positionOf} ${heroImages.length}`}
                en={`${index + 1} ${ui.en.positionOf} ${heroImages.length}`}
                class="sr-only"
              />
              <img
                src={displayImageUrl(responsive, src)}
                srcset={responsiveSrcset(responsive, LARGE_IMAGE_WIDTHS)}
                sizes={coverSizes(
                  responsive ? responsive.source.width / responsive.source.height : 16 / 9,
                  16 / 9,
                  [
                    { media: '(min-width: 1152px)', fixed: 1104 },
                    { viewport: 100, gutter: 48 },
                  ],
                )}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="size-full object-cover"
              />
            </div>
          )}
        </Carousel>
      )
    }

    <div
      class:list={[
        'flex flex-wrap items-baseline gap-x-6 gap-y-2 text-sm tracking-widest uppercase',
        { 'mt-4 sm:mt-6': heroImages.length > 0 },
      ]}
    >
      <T as="h1" cs={identity('cs')} en={identity('en')} class="shrink-0" />
      {about.services.length > 0 && (
        <T as="p" cs={services('cs')} en={services('en')} class="min-w-0 text-balance text-neutral-500" />
      )}
      <a href="/about/" class="ml-auto shrink-0 hover:underline focus-visible:underline"><T k="toAbout" /></a>
    </div>

    {
      selected.length > 0 && (
        <section class="mt-16 sm:mt-24">
          <SectionHeading k="selectedWork">
            <a href="/work/" class="shrink-0 hover:underline focus-visible:underline"><T k="allWork" /></a>
          </SectionHeading>
          <ProjectGrid projects={selected} heading="h3" />
        </section>
      )
    }

    <div class="mt-16 sm:mt-24">
      <ContactCard {contact} />
    </div>
  </div>
</Base>
