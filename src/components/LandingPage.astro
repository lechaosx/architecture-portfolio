---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Carousel from './Carousel.astro';
import ProjectGrid from './ProjectGrid.astro';
import SectionHeading from './SectionHeading.astro';
import T from './T.astro';
import { site } from '../singletons';
import { credentialedName } from '../site-title';
import { ui } from '../i18n';
import { workProjects } from '../projects';
import { getResponsiveImage } from '../server-images';
import {
  coverSizes,
  displayImageUrl,
  LARGE_IMAGE_WIDTHS,
  responsiveSrcset,
} from '../images';
import { webSite } from '../structured-data';

type Project = Pick<CollectionEntry<'projects'>, 'id' | 'data'>;

interface Props {
  landing: CollectionEntry<'landing'>['data'];
  projects: Project[];
}

const { landing, projects } = Astro.props;
const heroImages = await Promise.all(
  landing.images.map(async (src) => ({ src, responsive: await getResponsiveImage(src) })),
);
const selected = workProjects(projects).grid.slice(0, 3);
// Social sites show no SVG and an SVG has no share JPEG, so the first raster
// image is shared, else the newest cover.
const image =
  heroImages.find(({ responsive }) => responsive)?.responsive?.share ??
  (selected[0] && (await getResponsiveImage(selected[0].cover.image))?.share);
const link = 'underline underline-offset-4 hover:decoration-dotted';
---

<Base
  title={{
    cs: `${credentialedName} | ${ui.cs.tagline}`,
    en: `${credentialedName} | ${ui.en.tagline}`,
  }}
  {image}
  graph={[webSite({ site: new URL('/', Astro.site), name: credentialedName })]}
>
  <div class="mx-auto flex max-w-6xl flex-col gap-16 px-6 pt-12 pb-16 sm:pt-16 sm:pb-24">
    {
      heroImages.length === 1 ? (
        <img
          src={displayImageUrl(heroImages[0].responsive, heroImages[0].src)}
          srcset={responsiveSrcset(heroImages[0].responsive, LARGE_IMAGE_WIDTHS)}
          sizes="(min-width: 1152px) 1104px, calc(100vw - 48px)"
          width={heroImages[0].responsive?.source.width}
          height={heroImages[0].responsive?.source.height}
          alt=""
          loading="eager"
          decoding="async"
          class="w-full bg-neutral-100"
        />
      ) : heroImages.length > 1 && (
        <Carousel items={heroImages} autoAdvance>
          {({ src, responsive }: (typeof heroImages)[number], index: number) => (
            <div role="group">
              <T
                cs={`${index + 1} ${ui.cs.positionOf} ${heroImages.length}`}
                en={`${index + 1} ${ui.en.positionOf} ${heroImages.length}`}
                class="sr-only"
              />
              <img
                src={displayImageUrl(responsive, src)}
                srcset={responsiveSrcset(responsive, LARGE_IMAGE_WIDTHS)}
                sizes={coverSizes(
                  responsive ? responsive.source.width / responsive.source.height : 16 / 9,
                  16 / 9,
                  [
                    { media: '(min-width: 1152px)', fixed: 1104 },
                    { viewport: 100, gutter: 48 },
                  ],
                )}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="size-full object-cover"
              />
            </div>
          )}
        </Carousel>
      )
    }

    <div>
      <T
        as="h1"
        cs={site.description_cs}
        en={site.description_en}
        class="max-w-3xl text-3xl font-medium text-balance sm:text-4xl"
      />
      <p class="mt-6">
        <a href="/about/" class={link}><T k="toAbout" /></a>
      </p>
    </div>

    {
      selected.length > 0 && (
        <section>
          <SectionHeading k="selectedWork" />
          <ProjectGrid projects={selected} heading="h3" />
          <p class="mt-12 sm:mt-16">
            <a href="/work/" class={link}><T k="allWork" /></a>
          </p>
        </section>
      )
    }
  </div>
</Base>
