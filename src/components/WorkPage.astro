---
import Base from '../layouts/Base.astro';
import ProjectGrid from './ProjectGrid.astro';
import T from './T.astro';
import { credentialedName } from '../site-title';
import { ui } from '../i18n';
import { workProjects, type Project } from '../projects';
import { getResponsiveImage } from '../server-images';

interface Props {
  projects: Project[];
}

const { grid, listed } = workProjects(Astro.props.projects);
const image = grid[0] && (await getResponsiveImage(grid[0].cover.image))?.share;
---

<Base
  title={{ cs: `${ui.cs.work} | ${credentialedName}`, en: `${ui.en.work} | ${credentialedName}` }}
  {image}
>
  <div class="mx-auto max-w-6xl px-6 pt-12 pb-16 sm:pt-16 sm:pb-24">
    <T as="h1" k="work" class="mb-8 text-3xl font-medium sm:text-4xl" />

    {grid.length > 0 && <ProjectGrid projects={grid} heading="h2" />}

    {
      listed.length > 0 && (
        <div class:list={{ 'mt-16 sm:mt-24': grid.length > 0 }}>
          <hr class="border-neutral-200" />
          <ul class="mt-12 flex flex-col gap-8">
            {listed.map((p) => {
              const href = p.data.blocks.length > 0 ? `/projects/${p.id}/` : undefined;
              const Row = href ? 'a' : 'div';
              return (
                <li>
                  <Row {href} class:list={['block max-w-prose', { group: href }]}>
                    <div class="flex items-baseline justify-between">
                      <T
                        as="h2"
                        cs={p.data.title_cs}
                        en={p.data.title_en}
                        class="text-base font-medium group-hover:underline group-focus-visible:underline"
                      />
                      <span class="text-sm text-neutral-500">{p.data.year}</span>
                    </div>
                    {(p.data.location_cs || p.data.location_en) && (
                      <T
                        as="p"
                        cs={p.data.location_cs}
                        en={p.data.location_en}
                        class="text-sm text-neutral-500"
                      />
                    )}
                    {(p.data.brief_cs || p.data.brief_en) && (
                      <T
                        as="p"
                        cs={p.data.brief_cs}
                        en={p.data.brief_en}
                        class="mt-2 text-sm whitespace-pre-line"
                      />
                    )}
                  </Row>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</Base>
