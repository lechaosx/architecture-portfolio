---
import Base from '../layouts/Base.astro';
import ProjectFacts from './ProjectFacts.astro';
import ProjectGrid from './ProjectGrid.astro';
import T from './T.astro';
import ProjectBadges from './ProjectBadges.astro';
import { credentialedName } from '../site-title';
import { ui } from '../i18n';
import { formatPeriod } from '../period';
import { projectBadges, projectFacts } from '../project-facts';
import { workProjects, type Project } from '../projects';
import { getResponsiveImage } from '../server-images';

interface Props {
  projects: Project[];
}

const { grid, listed } = workProjects(Astro.props.projects);
const image = grid[0] && (await getResponsiveImage(grid[0].cover.image))?.share;
// One column template for every index row and its brief, so they line up. The
// period column matches the About facts' so a period reads alike on both; change
// them together.
const row =
  'grid grid-cols-[minmax(0,1fr)_1rem] items-baseline gap-x-4 sm:grid-cols-[8rem_minmax(0,3fr)_minmax(0,2fr)_1rem] sm:gap-x-8';
const marker = 'col-start-2 row-start-2 justify-self-end sm:col-start-4 sm:row-start-1';
---

<Base
  title={{ cs: `${ui.cs.work} | ${credentialedName}`, en: `${ui.en.work} | ${credentialedName}` }}
  {image}
>
  {/* As on the landing page, images open the page closer under the header than
      text does. */}
  <div
    class:list={[
      'mx-auto max-w-6xl px-6 pb-16 sm:pb-24',
      grid.length > 0 ? 'pt-8' : 'pt-12 sm:pt-16',
    ]}
  >
    <T as="h1" k="work" class="sr-only" />

    {grid.length > 0 && <ProjectGrid projects={grid} heading="h2" />}

    {/* The gap repeats ProjectGrid's row gap, so the index reads as the grid's
        next row; change them together. */}
    {
      listed.length > 0 && (
        <ul
          class:list={[
            'divide-y divide-neutral-200 border-y border-neutral-200',
            { 'mt-12 sm:mt-20': grid.length > 0 },
          ]}
        >
          {listed.map(({ id, data }) => {
            const hasBrief = Boolean(data.brief_cs || data.brief_en);
            const facts = projectFacts(data);
            const badges = projectBadges(data);
            const cells = (
              <>
                <T {...formatPeriod(data)} class="col-start-1 row-start-1 text-sm text-neutral-500 tabular-nums sm:row-span-2" />
                <T
                  as="h2"
                  cs={data.title_cs}
                  en={data.title_en}
                  class="col-start-1 row-start-2 font-medium sm:col-start-2 sm:row-start-1 text-balance group-hover:underline group-focus-visible:underline"
                />
                <T
                  cs={data.location_cs}
                  en={data.location_en}
                  class="col-start-1 row-start-3 text-sm text-neutral-500 sm:col-start-3 sm:row-start-1"
                />
              </>
            );
            return (
              <li>
                {data.blocks.length > 0 ? (
                  <a href={`/projects/${id}/`} class={`group ${row} py-3`}>
                    {cells}
                    <span aria-hidden="true" class={marker}>→</span>
                  </a>
                ) : hasBrief || facts.length > 0 || badges.length > 0 ? (
                  <details class="group/row">
                    <summary class={`group ${row} cursor-pointer list-none py-3 [&::-webkit-details-marker]:hidden`}>
                      {cells}
                      <span aria-hidden="true" class={`${marker} relative size-3 self-center`}>
                        <span class="absolute inset-x-0 top-1/2 h-px bg-current" />
                        <span class="absolute inset-y-0 left-1/2 w-px bg-current group-open/row:rotate-90 motion-safe:transition-transform" />
                      </span>
                    </summary>
                    <div class={`${row} pb-5`}>
                      <div class="col-start-1 space-y-5 sm:col-start-2">
                        <ProjectBadges {badges} />
                        {hasBrief && (
                          <T
                            as="p"
                            cs={data.brief_cs}
                            en={data.brief_en}
                            class="running-text columns-[35ch_2] gap-8 text-sm whitespace-pre-line text-neutral-700"
                          />
                        )}
                        {facts.length > 0 && <ProjectFacts {facts} />}
                      </div>
                    </div>
                  </details>
                ) : (
                  <div class={`${row} py-3`}>{cells}</div>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</Base>
