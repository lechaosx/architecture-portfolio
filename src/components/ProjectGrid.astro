---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import type { workProjects } from '../projects';

type Project = Pick<CollectionEntry<'projects'>, 'id' | 'data'>;

// ProjectCard's image sizes follow this grid's columns and gaps.
interface Props {
  projects: ReturnType<typeof workProjects<Project>>['grid'];
  heading: 'h2' | 'h3';
}

const { projects, heading } = Astro.props;
---

<div
  class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 sm:gap-x-12 sm:gap-y-20 lg:grid-cols-3 lg:gap-x-32"
>
  {
    projects.map((p) => (
      <ProjectCard
        slug={p.id}
        titleCs={p.data.title_cs}
        titleEn={p.data.title_en}
        year={p.data.year}
        locationCs={p.data.location_cs}
        locationEn={p.data.location_en}
        cover={p.cover.image}
        {heading}
      />
    ))
  }
</div>
