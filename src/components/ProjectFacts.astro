---
import T from './T.astro';
import ProjectBadges from './ProjectBadges.astro';
import type { Fact } from '../project-facts';

// The label column fits the longest label in either language, so values line
// up at the same place on every project; where the sheet is too narrow for
// it, labels sit above their values.
interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<div class="@container">
  <dl class="columns-[28rem_2] gap-12 text-sm">
    {
      facts.map(({ label, lang, lines, badges, href }) => (
        <div {lang} class="mb-3 grid break-inside-avoid items-baseline gap-y-0.5 @sm:grid-cols-[10rem_minmax(0,1fr)] @sm:gap-x-6">
          <dt class="text-xs tracking-widest text-neutral-500 uppercase">
            <T k={label} />
          </dt>
          <dd>
            {badges && <ProjectBadges {badges} />}
            {label === 'collaborators' ? (
              <ul class="space-y-2">
                {lines.map(({ names, cs, en }) => (
                  <li>
                    <span class="block whitespace-nowrap">{names.join(', ')}</span>
                    {(cs.trim() || en.trim()) && (
                      <T as="span" {cs} {en} class="block text-xs text-neutral-500" />
                    )}
                  </li>
                ))}
              </ul>
            ) : lines.map(({ cs, en }) => (
              <p>
                {(cs || en) && (href
                  ? <a {href} class="text-link [overflow-wrap:anywhere]"><T {cs} {en} /></a>
                  : <T {cs} {en} />)}
              </p>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
