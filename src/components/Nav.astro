---
import { site } from '../singletons';
import type { UiKey } from '../i18n';
import T from './T.astro';

interface Props {
  homeHref?: string;
  workHref?: string;
  aboutHref?: string;
  contactHref?: string;
}

const { homeHref = '/', workHref = '/work/', aboutHref = '/about/', contactHref } = Astro.props;
const links: { href: string; key: UiKey }[] = [
  { href: workHref, key: 'work' },
  { href: aboutHref, key: 'about' },
];
if (contactHref) links.push({ href: contactHref, key: 'contact' });

const isActive = (href: string) => Astro.url.pathname === href;
---

<header class="sticky top-0 z-40 border-b border-black bg-white">
  <nav
    class:list={[
      'mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4',
      { 'flex-wrap': contactHref },
    ]}
  >
    <a
      href={homeHref}
      class="flex flex-col gap-0.5 leading-none sm:flex-row sm:items-baseline sm:gap-1.5 sm:leading-normal"
    >
      <span class="text-xs font-normal tracking-widest">{site.credential}</span>
      <span
        class="text-base font-medium tracking-wide uppercase sm:text-lg sm:tracking-widest"
        >{site.name}</span
      >
    </a>

    <ul class="flex gap-1 text-sm tracking-wide uppercase sm:gap-6 sm:tracking-widest">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-section={l.key}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'border border-transparent px-2 py-1.5 whitespace-nowrap sm:py-0.5',
                isActive(l.href)
                  ? 'border-black bg-black text-white'
                  : 'hover:border-black',
              ]}
            >
              <T k={l.key} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
