---
import { marked } from 'marked';

// CMS frontmatter holds both Markdown strings; global.css hides the inactive
// language after `marked` renders them.
interface Props {
  cs: string;
  en: string;
  class: string;
}

const { cs, en, class: cls } = Astro.props;
const render = (md: string) => marked.parse(md, { async: false });
---

<div lang="cs" class={cls} set:html={render(cs)} /><div
  lang="en"
  class={cls}
  set:html={render(en)}
/>
