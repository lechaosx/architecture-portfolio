---
import { pageLanguage } from '../locale';
import { Marked, marked } from 'marked';
import { bindOneLetterWords } from '../one-letter-words';
import { canSplitProse } from '../prose';

const lang = pageLanguage(Astro.url.pathname);

interface Props {
  cs: string;
  en: string;
}

const { cs, en } = Astro.props;
const czech = new Marked({
  renderer: {
    // Only the HTML renderer's text: markup, code, link targets and image alt
    // text, which marked renders separately, stay as written. A soft line
    // break renders as a space.
    text(token) {
      token.text = bindOneLetterWords(token.text, { newlinesAreSpaces: true });
      return false;
    },
  },
});
const languages = [
  { lang: 'cs', html: czech.parse(cs, { async: false }) },
  { lang: 'en', html: marked.parse(en, { async: false }) },
];
const visibleText = (html: string) => html
  .replace(/<br\s*\/?>|<\/(?:p|div|h[1-6]|li|blockquote|pre)>/gi, ' ')
  .replace(/<[^>]*>/g, '')
  .replace(/&(?:nbsp|#160|#xa0);/gi, ' ');
---

{
  languages.filter((entry) => entry.lang === lang).map(({ lang, html }) => (
    <div
      {lang}
      class:list={[
        'running-text prose prose-neutral max-w-none dark:prose-invert',
        { 'prose-columns': canSplitProse(visibleText(html)) },
      ]}
      set:html={html}
    />
  ))
}
