---
import { localizedPath } from '../locale';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ApproachIcon from './ApproachIcon.astro';
import PageContent from './PageContent.astro';
import T from './T.astro';
import Paragraphs from './Paragraphs.astro';
import Prose from './Prose.astro';
import SectionHeading from './SectionHeading.astro';
import ServicesLine from './ServicesLine.astro';
import { credentialedName } from '../site-title';
import { ui } from '../i18n';
import { getResponsiveImage } from '../server-images';
import { displayImageUrl, responsiveSrcset, THUMBNAIL_WIDTHS } from '../images';
import { formatPeriod } from '../period';
import { profilePage } from '../structured-data';
import { excerpt } from '../project-description';


interface Props {
  site: CollectionEntry<'site'>['data'];
  about: CollectionEntry<'about'>['data'];
  contact: CollectionEntry<'contact'>['data'];
}

const { site, about, contact } = Astro.props;
const responsivePortrait = about.portrait
  ? await getResponsiveImage(about.portrait)
  : undefined;
const origin = new URL('/', Astro.site);
const facts = [
  { k: 'experience', rows: about.experience },
  { k: 'education', rows: about.education },
  { k: 'awards', rows: about.awards },
] as const;
const hasFacts = facts.some(({ rows }) => rows.length > 0);
---

<Base
  title={{
    cs: `${ui.cs.about} | ${credentialedName(site)}`,
    en: `${ui.en.about} | ${credentialedName(site)}`,
  }}
  description={{ cs: excerpt(about.bio.cs), en: excerpt(about.bio.en) }}
  image={responsivePortrait?.share}
  graph={{
    cs: [profilePage({ site: origin, url: new URL(localizedPath(Astro.url.pathname, 'cs'), origin).href })],
    en: [profilePage({ site: origin, url: new URL(localizedPath(Astro.url.pathname, 'en'), origin).href })],
  }}
  {site}
  {about}
  {contact}
>
  {/* A portrait opens the page: first when stacked, top-aligned with the bio
      beside it. */}
  <PageContent imagery={!!about.portrait}>
    <T as="h1" k="about" class="sr-only" />
    <div class="flex flex-wrap-reverse items-end gap-12">
      {/* Beside a taller portrait the column stretches, so the services
          line meets the portrait's foot. */}
      <div class="reveal flex min-w-0 flex-[1_1_35ch] flex-col justify-between self-stretch">
        <Prose {...about.bio} />
        {about.services.length > 0 && (
          <section class="mt-6">
            <T as="h2" k="services" class="sr-only" />
            <ServicesLine services={about.services} />
          </section>
        )}
      </div>
      {
        about.portrait && (
          <img
            src={displayImageUrl(responsivePortrait, about.portrait)}
            srcset={responsiveSrcset(responsivePortrait, THUMBNAIL_WIDTHS)}
            sizes="(min-width: 1152px) 528px, (min-width: 726px) calc((100vw - 96px) / 2), calc(100vw - 48px)"
            width={responsivePortrait?.source.width}
            height={responsivePortrait?.source.height}
            alt={credentialedName(site)}
            loading="eager"
            fetchpriority="high"
            class="reveal min-w-0 flex-[1_1_35ch] bg-neutral-100"
          />
        )
      }
    </div>

    {
      about.approaches.length > 0 && (
        <section class="mt-16 sm:mt-24">
          <SectionHeading k="approach" />
          <ul class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
            {about.approaches.map((item) => (
              <li class="reveal">
                <div class="flex items-center gap-3">
                  <ApproachIcon icon={item.icon} class="size-5 shrink-0 text-black" />
                  <T as="h3" {...item.label} class="text-sm tracking-widest uppercase" />
                </div>
                <Paragraphs {...item.text} class="mt-3 space-y-4 text-neutral-700" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      hasFacts && (
        <div class="mt-16 grid gap-x-12 gap-y-14 sm:mt-24 md:grid-cols-2">
          {facts.map(
            ({ k, rows }) =>
              rows.length > 0 && (
                <section class="reveal">
                  <SectionHeading {k} />
                  <ul class="space-y-5">
                    {rows.map((row) => (
                      <li class="grid grid-cols-[6rem_minmax(0,1fr)] items-baseline gap-x-4 sm:grid-cols-[8rem_minmax(0,1fr)]">
                        <div class="text-sm text-neutral-500">
                          <T {...formatPeriod(row)} class="tabular-nums" />
                          {'degree' in row && row.degree && <p>{row.degree}</p>}
                          {'skills' in row && row.skills.length > 0 && (
                            <>
                              <T k="skills" class="sr-only" />
                              <ul class="mt-2 flex flex-wrap gap-2 text-xs text-neutral-600">
                                {row.skills.map((skill) => <li class="rounded-sm bg-neutral-100 px-2 py-1"><T {...skill.name} /></li>)}
                              </ul>
                            </>
                          )}
                        </div>
                        <div>
                          <p class="text-balance">
                            <T {...row.title} class="font-medium" />,{' '}
                            <T {...row.place} />
                          </p>
                          <T
                            as="p"
                            {...row.department}
                            class="text-sm text-balance text-neutral-500 empty:hidden"
                          />
                        </div>
                        {row.description && (
                          <Paragraphs
                            {...row.description}
                            class="col-span-full mt-2 space-y-3 text-sm text-neutral-700 sm:col-start-2"
                          />
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              ),
          )}
        </div>
      )
    }
  </PageContent>
</Base>
