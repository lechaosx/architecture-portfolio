---
import { getCollection } from 'astro:content';
import { frontmatter as home } from '../content/singletons/home.md';
import { LARGE_IMAGE_WIDTHS, responsiveSrcset } from '../images';
import { getResponsiveImage } from '../server-images';
import { ui } from '../i18n';

const curated: string[] = home.gallery ?? [];
const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
const images =
  curated.length > 0
    ? curated
    : projects.flatMap((p) => [
        p.data.cover,
        ...p.data.gallery.map((image) => image.image),
      ]);
const displayImages = await Promise.all(
  images.map(async (src) => ({ src, responsive: await getResponsiveImage(src) })),
);
---

{
  images.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 pt-8">
      <h2 class="sr-only">
        <span lang="cs">{ui.cs.selectedWork}</span>
        <span lang="en">{ui.en.selectedWork}</span>
      </h2>
      <div data-carousel class="relative border border-black">
        <div
          data-carousel-track
          class="no-scrollbar flex aspect-[16/9] snap-x snap-mandatory overflow-x-auto"
        >
          {displayImages.map(({ src, responsive }, i) => (
            <div
              data-slide
              role="group"
              class="h-full w-full shrink-0 snap-start"
            >
              <span lang="cs" class="sr-only">
                {i + 1} {ui.cs.positionOf} {images.length}
              </span>
              <span lang="en" class="sr-only">
                {i + 1} {ui.en.positionOf} {images.length}
              </span>
              <img
                src={src}
                srcset={responsiveSrcset(responsive, LARGE_IMAGE_WIDTHS)}
                sizes="(min-width: 1152px) 1104px, calc(100vw - 48px)"
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>

        {images.length > 1 && (
          <>
            <button
              type="button"
              data-carousel-prev
              class="absolute top-1/2 left-3 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center border border-transparent bg-white/80 text-lg text-black hover:border-black hover:bg-white active:bg-black active:text-white"
            >
              <span aria-hidden="true">‹</span>
              <span lang="cs" class="sr-only">{ui.cs.previousImage}</span>
              <span lang="en" class="sr-only">{ui.en.previousImage}</span>
            </button>
            <button
              type="button"
              data-carousel-next
              class="absolute top-1/2 right-3 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center border border-transparent bg-white/80 text-lg text-black hover:border-black hover:bg-white active:bg-black active:text-white"
            >
              <span aria-hidden="true">›</span>
              <span lang="cs" class="sr-only">{ui.cs.nextImage}</span>
              <span lang="en" class="sr-only">{ui.en.nextImage}</span>
            </button>
            <div class="absolute bottom-3 left-1/2 flex -translate-x-1/2 gap-2">
              {displayImages.map((_, i) => (
                <button
                  type="button"
                  data-dot
                  class="h-2.5 w-2.5 cursor-pointer rounded-full border border-black bg-white/80 aria-[current=true]:bg-black"
                >
                  <span lang="cs" class="sr-only">
                    {ui.cs.goToImage} {i + 1}
                  </span>
                  <span lang="en" class="sr-only">
                    {ui.en.goToImage} {i + 1}
                  </span>
                </button>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )
}

<script>
  // Enhances a native scroll-snap strip with arrows, dots and auto-advance.
  function initCarousel() {
    const root = document.querySelector<HTMLElement>('[data-carousel]');
    if (!root) return;
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    if (!track) return;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    if (slides.length < 2) return;

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const indexNow = () => Math.round(track.scrollLeft / track.clientWidth);
    const goto = (i: number) => {
      const n = ((i % slides.length) + slides.length) % slides.length;
      track.scrollTo({
        left: n * track.clientWidth,
        behavior: motionQuery.matches ? 'auto' : 'smooth',
      });
    };
    const sync = () => {
      const i = indexNow();
      dots.forEach((d, di) =>
        d.setAttribute('aria-current', di === i ? 'true' : 'false'),
      );
    };

    root
      .querySelector('[data-carousel-prev]')
      ?.addEventListener('click', () => goto(indexNow() - 1));
    root
      .querySelector('[data-carousel-next]')
      ?.addEventListener('click', () => goto(indexNow() + 1));
    dots.forEach((dot, index) =>
      dot.addEventListener('click', () => goto(index)),
    );
    track.addEventListener('scroll', () => requestAnimationFrame(sync), {
      passive: true,
    });
    sync();

    let timer: number | undefined;
    const stop = () => {
      if (timer === undefined) return;
      clearInterval(timer);
      timer = undefined;
    };
    const syncTimer = () => {
      if (motionQuery.matches || root.matches(':hover, :focus-within')) {
        stop();
      } else if (timer === undefined) {
        timer = window.setInterval(() => goto(indexNow() + 1), 5000);
      }
    };
    for (const event of [
      'pointerenter',
      'pointerleave',
      'focusin',
      'focusout',
    ]) {
      root.addEventListener(event, syncTimer);
    }
    motionQuery.addEventListener('change', syncTimer);
    syncTimer();
  }

  initCarousel();
</script>
