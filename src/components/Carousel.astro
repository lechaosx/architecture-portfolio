---
import T from './T.astro';
import { ui } from '../i18n';

// A native scroll-snap strip of two or more slides, enhanced with arrows and
// dots. The default slot is a function rendering one slide element per item,
// so the dots here and the script's slide count are the same items.
interface Props {
  items: unknown[];
  /** Advances every few seconds, pausing on hover and focus. */
  autoAdvance?: boolean;
}

const { items, autoAdvance = false } = Astro.props;
const slides = await Promise.all(
  items.map((item, index) => Astro.slots.render('default', [item, index])),
);
---

<div data-carousel data-auto-advance={autoAdvance || undefined} class="relative bg-neutral-100">
  <div
    data-carousel-track
    class="no-scrollbar flex aspect-video snap-x snap-mandatory overflow-x-auto *:relative *:size-full *:shrink-0 *:snap-start"
  >
    {slides.map((slide) => <Fragment set:html={slide} />)}
  </div>
  <button
    type="button"
    data-carousel-prev
    class="media-navigation-button absolute top-1/2 left-3 -translate-y-1/2"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M15.5 5l-7 7 7 7" />
    </svg>
    <T k="previousImage" class="sr-only" />
  </button>
  <button
    type="button"
    data-carousel-next
    class="media-navigation-button absolute top-1/2 right-3 -translate-y-1/2"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M8.5 5l7 7-7 7" />
    </svg>
    <T k="nextImage" class="sr-only" />
  </button>
  <div class="absolute bottom-3 left-1/2 flex -translate-x-1/2 gap-2">
    {
      slides.map((_, index) => (
        <button
          type="button"
          data-carousel-dot
          class="carousel-dot size-2.5 cursor-pointer rounded-full"
        >
          <T
            cs={`${ui.cs.goToImage} ${index + 1}`}
            en={`${ui.en.goToImage} ${index + 1}`}
            class="sr-only"
          />
        </button>
      ))
    }
  </div>
</div>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    if (!track) continue;
    const originals = Array.from(track.children) as HTMLElement[];
    const count = originals.length;
    const dots = Array.from(
      root.querySelectorAll<HTMLElement>('[data-carousel-dot]'),
    );
    const wrap = (index: number) => ((index % count) + count) % count;
    // Empty snap cells let native gestures travel a full turn either way,
    // without rendering or loading every image along the way.
    track.style.position = 'relative';
    for (let at = 0; at <= 2 * count; at++) {
      const cell = document.createElement('div');
      cell.setAttribute('aria-hidden', 'true');
      cell.style.pointerEvents = 'none';
      track.append(cell);
    }
    for (const slide of originals) {
      slide.style.position = 'absolute';
      slide.style.top = '0';
      // Moving an image must not change a native gesture's snap target.
      slide.style.scrollSnapAlign = 'none';
    }

    type Frame = { at: number; index: number };
    let frames: Frame[] = [];
    let current = 0;
    let visitorScrolling = false;
    let visitorMoved = false;
    let position = count;
    let target = count;
    let direction = 1;
    let pending = false;
    let animation: number | undefined;
    let lastFrame = 0;
    const sync = () => {
      dots.forEach((dot, index) =>
        dot.setAttribute('aria-current', index === current ? 'true' : 'false'),
      );
    };
    const render = (next: Frame[]) => {
      frames = next;
      originals.forEach((slide, index) => {
        const frame = frames.find((frame) => frame.index === index);
        slide.hidden = !frame;
        slide.inert = !frame;
        if (frame) slide.style.left = `${100 * frame.at}%`;
      });
    };
    const visible = () => frames.filter((frame) => Math.abs(frame.at - position) < 1);
    const draw = () => {
      track.scrollLeft = position * track.clientWidth;
    };
    const settle = () => {
      position = target = count;
      render([{ at: count, index: current }]);
      draw();
      track.style.scrollSnapType = '';
    };
    const animate = (time: number) => {
      if (pending) {
        pending = false;
        // Keep the visible pair in place; replace only a wholly offscreen
        // frame. Coalescing input here never activates a same-task skip.
        position = track.scrollLeft / track.clientWidth;
        const shown = visible();
        const shift = count - Math.floor(position);
        position += shift;
        shown.forEach((frame) => frame.at += shift);
        const existing = shown.find((frame) => frame.index === current);
        target = existing?.at ?? (direction > 0
          ? Math.ceil(position + 1)
          : Math.floor(position - 1));
        render(existing ? shown : [...shown, { at: target, index: current }]);
        draw();
      }
      position += (target - position) * (1 - Math.exp(-(time - lastFrame) / 65));
      lastFrame = time;
      if (Math.abs(target - position) < 0.0001) {
        animation = undefined;
        settle();
      } else {
        draw();
        animation = requestAnimationFrame(animate);
      }
    };
    const goTo = (index: number) => {
      direction = Math.sign(index - current) || direction;
      current = wrap(index);
      visitorScrolling = false;
      sync();
      if (reducedMotion.matches) {
        if (animation !== undefined) cancelAnimationFrame(animation);
        animation = undefined;
        pending = false;
        settle();
      } else {
        pending = true;
        track.style.scrollSnapType = 'none';
        if (animation === undefined) {
          lastFrame = performance.now();
          animation = requestAnimationFrame(animate);
        }
      }
    };
    const takeOver = () => {
      if (animation !== undefined) {
        cancelAnimationFrame(animation);
        animation = undefined;
        render(visible());
        track.style.scrollSnapType = '';
      }
      pending = false;
      if (!visitorScrolling) visitorMoved = false;
      // The compositor may already have scrolled before delivering wheel.
      const at = track.scrollLeft / track.clientWidth;
      visitorMoved ||= at !== position;
      position = at;
      visitorScrolling = true;
    };

    root
      .querySelector('[data-carousel-prev]')
      ?.addEventListener('click', () => goTo(current - 1));
    root
      .querySelector('[data-carousel-next]')
      ?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, index) =>
      dot.addEventListener('click', () => goTo(index)),
    );
    for (const event of ['pointerdown', 'keydown', 'focusin']) {
      track.addEventListener(event, takeOver, {
        passive: true,
      });
    }
    // A vertical wheel over the track scrolls the page, not the track.
    track.addEventListener(
      'wheel',
      (event) => {
        if (event.deltaX || event.shiftKey) takeOver();
      },
      { passive: true },
    );
    track.addEventListener(
      'scroll',
      () => {
        if (!visitorScrolling) return;
        const previous = position;
        position = track.scrollLeft / track.clientWidth;
        visitorMoved ||= position !== previous;
        const next = [...new Set([Math.floor(position), Math.ceil(position)])].map((at) => {
          const nearest = frames.reduce((near, frame) =>
            Math.abs(frame.at - at) < Math.abs(near.at - at) ? frame : near,
          );
          return { at, index: wrap(nearest.index + at - nearest.at) };
        });
        render(next);
        current = next.find((frame) => frame.at === Math.round(position))!.index;
        sync();
      },
      { passive: true },
    );
    track.addEventListener('scrollend', () => {
      // Recentring can queue a scrollend before a new gesture starts moving.
      if (animation !== undefined || !visitorScrolling || !visitorMoved) return;
      visitorScrolling = false;
      settle();
    });
    settle();
    sync();
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) goTo(current);
    });

    if (root.dataset.autoAdvance === undefined) continue;
    let timer: number | undefined;
    const syncTimer = () => {
      if (reducedMotion.matches || root.matches(':hover, :focus-within')) {
        clearInterval(timer);
        timer = undefined;
      } else if (timer === undefined) {
        timer = window.setInterval(() => goTo(current + 1), 5000);
      }
    };
    for (const event of ['pointerenter', 'pointerleave', 'focusin', 'focusout']) {
      root.addEventListener(event, syncTimer);
    }
    reducedMotion.addEventListener('change', syncTimer);
    syncTimer();
  }
</script>
