---
import T from './T.astro';
import { ui } from '../i18n';

// A native scroll-snap strip of two or more slides, enhanced with arrows and
// dots. The default slot is a function rendering one slide element per item,
// so the dots here and the script's slide count are the same items.
interface Props {
  items: unknown[];
  /** Advances every few seconds, pausing on hover and focus. */
  autoAdvance?: boolean;
}

const { items, autoAdvance = false } = Astro.props;
const slides = await Promise.all(
  items.map((item, index) => Astro.slots.render('default', [item, index])),
);
---

<div data-carousel data-auto-advance={autoAdvance || undefined} class="relative bg-neutral-100">
  <div
    data-carousel-track
    class="no-scrollbar flex aspect-video snap-x snap-mandatory overflow-x-auto *:relative *:size-full *:shrink-0 *:snap-start"
  >
    {slides.map((slide) => <Fragment set:html={slide} />)}
  </div>
  <button
    type="button"
    data-carousel-prev
    class="media-navigation-button absolute top-1/2 left-3 -translate-y-1/2"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M15.5 5l-7 7 7 7" />
    </svg>
    <T k="previousImage" class="sr-only" />
  </button>
  <button
    type="button"
    data-carousel-next
    class="media-navigation-button absolute top-1/2 right-3 -translate-y-1/2"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M8.5 5l7 7-7 7" />
    </svg>
    <T k="nextImage" class="sr-only" />
  </button>
  <div class="absolute bottom-3 left-1/2 flex -translate-x-1/2 gap-2">
    {
      slides.map((_, index) => (
        <button
          type="button"
          data-carousel-dot
          class="carousel-dot size-2.5 cursor-pointer rounded-full"
        >
          <T
            cs={`${ui.cs.goToImage} ${index + 1}`}
            en={`${ui.en.goToImage} ${index + 1}`}
            class="sr-only"
          />
        </button>
      ))
    }
  </div>
</div>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    if (!track) continue;
    const originals = Array.from(track.children) as HTMLElement[];
    const count = originals.length;
    const dots = Array.from(
      root.querySelectorAll<HTMLElement>('[data-carousel-dot]'),
    );
    const wrap = (index: number) => ((index % count) + count) % count;
    const clone = (slide: Element) => {
      const copy = slide.cloneNode(true) as HTMLElement;
      copy.inert = true;
      copy.setAttribute('aria-hidden', 'true');
      copy.style.viewTransitionName = 'none';
      // The lightbox's thumbnail registry must point to original slides.
      copy.removeAttribute('data-lightbox-index');
      return copy;
    };
    const first = track.firstElementChild!;
    const last = track.lastElementChild!;
    track.prepend(clone(last));
    track.append(clone(first));

    // The current slide is state; the smooth scroll only chases it. Only the
    // visitor's own scrolling of the track moves it from the scroll position.
    let current = 0;
    let visitorScrolling = false;
    let position = 0;
    let target = 0;
    let animation: number | undefined;
    let lastFrame = 0;
    const sync = () => {
      dots.forEach((dot, index) =>
        dot.setAttribute('aria-current', index === current ? 'true' : 'false'),
      );
    };
    // Boundary copies make equivalent positions one full turn apart look
    // identical, including a partially visible pair of slides.
    const draw = () => {
      track.scrollLeft = (wrap(position) + 1) * track.clientWidth;
    };
    const settle = () => {
      position = target = current;
      draw();
      track.style.scrollSnapType = '';
    };
    const animate = (time: number) => {
      position += (target - position) * (1 - Math.exp(-(time - lastFrame) / 65));
      lastFrame = time;
      if (Math.abs(target - position) < 0.0001) {
        animation = undefined;
        settle();
      } else {
        draw();
        animation = requestAnimationFrame(animate);
      }
    };
    const goTo = (index: number) => {
      if (animation === undefined) {
        position = current + position - Math.round(position);
        target = index;
      } else {
        target += index - current;
      }
      current = wrap(index);
      visitorScrolling = false;
      sync();
      if (reducedMotion.matches) {
        if (animation !== undefined) cancelAnimationFrame(animation);
        animation = undefined;
        settle();
      } else if (animation === undefined) {
        track.style.scrollSnapType = 'none';
        lastFrame = performance.now();
        animation = requestAnimationFrame(animate);
      }
    };
    const takeOver = () => {
      if (animation !== undefined) {
        cancelAnimationFrame(animation);
        animation = undefined;
        track.style.scrollSnapType = '';
      }
      position = target = track.scrollLeft / track.clientWidth - 1;
      visitorScrolling = true;
    };

    root
      .querySelector('[data-carousel-prev]')
      ?.addEventListener('click', () => goTo(current - 1));
    root
      .querySelector('[data-carousel-next]')
      ?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, index) =>
      dot.addEventListener('click', () => goTo(index)),
    );
    // Inert copies send pointer clicks to the track; activate their original.
    track.addEventListener('click', (event) => {
      if (event.target !== track) return;
      const x = event.clientX - track.getBoundingClientRect().left;
      const index = Math.floor((track.scrollLeft + x) / track.clientWidth) - 1;
      originals[wrap(index)].click();
    });
    for (const event of ['pointerdown', 'keydown', 'focusin']) {
      track.addEventListener(event, takeOver, {
        passive: true,
      });
    }
    // A vertical wheel over the track scrolls the page, not the track.
    track.addEventListener(
      'wheel',
      (event) => {
        if (event.deltaX || event.shiftKey) takeOver();
      },
      { passive: true },
    );
    track.addEventListener(
      'scroll',
      () => {
        if (!visitorScrolling) return;
        position = target = track.scrollLeft / track.clientWidth - 1;
        current = wrap(Math.round(position));
        sync();
      },
      { passive: true },
    );
    track.addEventListener('scrollend', () => {
      if (animation !== undefined || !visitorScrolling) return;
      visitorScrolling = false;
      settle();
    });
    settle();
    sync();
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) goTo(current);
    });

    if (root.dataset.autoAdvance === undefined) continue;
    let timer: number | undefined;
    const syncTimer = () => {
      if (reducedMotion.matches || root.matches(':hover, :focus-within')) {
        clearInterval(timer);
        timer = undefined;
      } else if (timer === undefined) {
        timer = window.setInterval(() => goTo(current + 1), 5000);
      }
    };
    for (const event of ['pointerenter', 'pointerleave', 'focusin', 'focusout']) {
      root.addEventListener(event, syncTimer);
    }
    reducedMotion.addEventListener('change', syncTimer);
    syncTimer();
  }
</script>
