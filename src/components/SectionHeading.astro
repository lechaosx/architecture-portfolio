---
import T from './T.astro';
import type { UiKey } from '../i18n';

// The default slot ends the heading row, on the same rule and in the same
// small caps as the heading, e.g. a link onward.
interface Props {
  k: UiKey;
}
---

<div
  class="mb-6 flex items-baseline-last justify-between gap-6 border-b border-black pb-2 text-sm tracking-widest uppercase"
>
  <T as="h2" k={Astro.props.k} />
  <slot />
</div>
