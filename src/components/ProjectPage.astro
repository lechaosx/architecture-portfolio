---
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.svelte';
import ProjectBlocks from './ProjectBlocks.astro';
import ProjectFacts from './ProjectFacts.astro';
import T from './T.astro';
import { site as owner } from '../singletons';
import { credentialedName } from '../site-title';
import { getResponsiveImage } from '../server-images';
import { projectDescription } from '../project-description';
import { creativeWork } from '../structured-data';
import { projectFacts } from '../project-facts';
import type { Project } from '../projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const d = project.data;

const images = d.blocks.flatMap((block) =>
  block.type === 'text' ? [] : block.images,
);
const responsiveImages = await Promise.all(
  images.map(({ image }) => getResponsiveImage(image)),
);
// The first image is the project's cover.
const cover = responsiveImages[0]?.share;
const description = projectDescription(d);
const site = new URL('/', Astro.site);
---

<Base
  title={{
    cs: `${d.title_cs} | ${credentialedName}`,
    en: `${d.title_en} | ${credentialedName}`,
  }}
  {description}
  image={cover}
  type="article"
  graph={[
    creativeWork({
      site,
      url: new URL(Astro.url.pathname, site).href,
      owner: owner.name,
      project: d,
      description: description.cs,
      images,
      responsiveImages,
    }),
  ]}
>
  <article class="mx-auto max-w-6xl px-6 pt-12 pb-16 sm:pt-16 sm:pb-24">
    <a href="/work/" class="text-sm text-neutral-500 hover:text-neutral-900">
      <T k="backToWork" />
    </a>

    <header class="mt-6 mb-8">
      <T
        as="h1"
        cs={d.title_cs}
        en={d.title_en}
        class="text-3xl font-medium sm:text-4xl"
      />
      <div class="mt-8 space-y-8">
        {
          (d.brief_cs || d.brief_en) && (
            <T
              as="p"
              cs={d.brief_cs}
              en={d.brief_en}
              class="running-text max-w-prose leading-7 whitespace-pre-line text-neutral-700"
            />
          )
        }
        <ProjectFacts facts={projectFacts(d, { placeAndPeriod: true })} />
      </div>
    </header>

    <ProjectBlocks projectId={project.id} blocks={d.blocks} {responsiveImages} />
    {images.length > 0 && <Gallery {images} {responsiveImages} client:load />}
  </article>
</Base>
