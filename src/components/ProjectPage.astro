---
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.svelte';
import ProjectBlocks from './ProjectBlocks.astro';
import T from './T.astro';
import { credentialedName } from '../site-title';
import { getResponsiveImage } from '../server-images';
import { projectDescription } from '../project-description';
import { creativeWork } from '../structured-data';
import type { Project } from '../projects';

interface Props {
  project: Project;
  /** Its neighbours in the work page's order. */
  previous?: Project;
  next?: Project;
}

const { project, previous, next } = Astro.props;
const neighbours = [
  { k: 'previousProject', to: previous, align: '' },
  { k: 'nextProject', to: next, align: 'col-start-2 text-right' },
] as const;
const d = project.data;

const meta = (loc?: string) => [loc, d.year].filter(Boolean).join(' · ');
const images = d.blocks.flatMap((block) =>
  block.type === 'text' ? [] : block.images,
);
const responsiveImages = await Promise.all(
  images.map(({ image }) => getResponsiveImage(image)),
);
// The first image is the project's cover.
const cover = responsiveImages[0]?.share;
const description = projectDescription(d);
const site = new URL('/', Astro.site);
---

<Base
  title={{
    cs: `${d.title_cs} | ${credentialedName}`,
    en: `${d.title_en} | ${credentialedName}`,
  }}
  {description}
  image={cover}
  type="article"
  graph={[
    creativeWork({
      site,
      url: new URL(Astro.url.pathname, site).href,
      project: d,
      description: description.cs,
      images,
      responsiveImages,
    }),
  ]}
>
  <article class="mx-auto max-w-6xl px-6 pt-12 sm:pt-16">
    <a href="/work/" class="text-sm text-neutral-500 hover:text-neutral-900">
      <T k="backToWork" />
    </a>

    <header class="mt-6 mb-8">
      <T
        as="h1"
        cs={d.title_cs}
        en={d.title_en}
        class="text-3xl font-medium sm:text-4xl"
      />
      <T
        as="p"
        cs={meta(d.location_cs)}
        en={meta(d.location_en)}
        class="mt-2 text-neutral-500"
      />
      {
        (d.brief_cs || d.brief_en) && (
          <T
            as="p"
            cs={d.brief_cs}
            en={d.brief_en}
            class="mt-4 max-w-prose whitespace-pre-line"
          />
        )
      }
    </header>

    <ProjectBlocks projectId={project.id} blocks={d.blocks} {responsiveImages} />
    {images.length > 0 && <Gallery {images} {responsiveImages} client:load />}
  </article>

  <div class="mx-auto max-w-6xl px-6 pb-16 sm:pb-24">
    {
      (previous || next) && (
        <nav class="mt-16 grid grid-cols-2 gap-x-6 border-t border-black pt-4 sm:mt-24">
          <T as="h2" k="projects" class="sr-only" />
          {neighbours.map(
            ({ k, to, align }) =>
              to && (
                <a href={`/projects/${to.id}/`} class={`group ${align}`}>
                  <T k={k} class="block text-sm tracking-widest uppercase" />
                  <T
                    cs={to.data.title_cs}
                    en={to.data.title_en}
                    class="mt-2 block text-xl font-medium tracking-tight text-balance group-hover:underline group-focus-visible:underline sm:text-2xl"
                  />
                </a>
              ),
          )}
        </nav>
      )
    }
  </div>
</Base>
