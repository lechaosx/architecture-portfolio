---
import { pageLanguage, localizedPath } from '../locale';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.svelte';
import ProjectBlocks from './ProjectBlocks.astro';
import ProjectFacts from './ProjectFacts.astro';
import PageContent from './PageContent.astro';
import PlainProse from './PlainProse.astro';
import T from './T.astro';
import ProjectBadges from './ProjectBadges.astro';
import { credentialedName } from '../site-title';
import { getResponsiveImage } from '../server-images';
import { projectDescription } from '../project-description';
import { creativeWork } from '../structured-data';
import { projectBadges, projectFacts } from '../project-facts';
import { projectCover, type Project } from '../projects';

const lang = pageLanguage(Astro.url.pathname);

interface Props {
  project: Project;
  site: CollectionEntry<'site'>['data'];
  about: CollectionEntry<'about'>['data'];
  contact: CollectionEntry<'contact'>['data'];
}

const { project, site, about, contact } = Astro.props;
const d = project.data;
const facts = projectFacts(d, { placeAndPeriod: true });

const images = d.blocks.flatMap((block) =>
  block.type === 'text' ? [] : block.images,
);
const responsiveImages = await Promise.all(
  images.map(({ image }) => getResponsiveImage(image)),
);
const cover = projectCover(d.thumbnail, images);
const responsiveCover = cover ? await getResponsiveImage(cover.image) : undefined;
const description = projectDescription(d);
const origin = new URL('/', Astro.site);
const graph = (language: 'cs' | 'en') => [creativeWork({
  site: origin,
  url: new URL(localizedPath(Astro.url.pathname, language), origin).href,
  project: d,
  description: description[language],
  lang: language,
  images,
  responsiveImages,
  responsiveCover,
})];
---

<Base
  title={{
    cs: `${d.title.cs} | ${credentialedName(site)}`,
    en: `${d.title.en} | ${credentialedName(site)}`,
  }}
  {description}
  image={responsiveCover?.share}
  type="article"
  graph={{ cs: graph('cs'), en: graph('en') }}
  {site}
  {about}
  {contact}
>
  <PageContent as="article">
    <a href={localizedPath('/work/', lang)} class="text-sm text-neutral-500 hover:text-neutral-900">
      <T k="backToWork" />
    </a>

    <header class="mt-6 mb-8">
      <T
        as="h1"
        {...d.title}
        class="text-3xl font-medium sm:text-4xl"
      />
      <ProjectBadges badges={projectBadges(d)} class="mt-4" />
      {d.brief && (
        <div class="mt-8">
          <PlainProse
            {...d.brief}
            class="leading-7 text-neutral-700"
          />
        </div>
      )}
      <div class="mt-8">
        <ProjectFacts {facts} />
      </div>
    </header>

    <ProjectBlocks projectId={project.id} blocks={d.blocks} {responsiveImages} coverPath={cover?.image} />
    {images.length > 0 && <Gallery {images} {responsiveImages} client:load />}
  </PageContent>
</Base>
