---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.svelte';
import ProjectBlocks from './ProjectBlocks.astro';
import T from './T.astro';
import { credentialedName } from '../site-title';
import { getResponsiveImage } from '../server-images';

interface Props {
  project: Pick<CollectionEntry<'projects'>, 'id' | 'data'>;
}

const { project } = Astro.props;
const d = project.data;

const meta = (loc?: string) => [loc, d.year].filter(Boolean).join(' · ');
const images = d.blocks.flatMap((block) =>
  block.type === 'text' ? [] : block.images,
);
const responsiveImages = await Promise.all(
  images.map(({ image }) => getResponsiveImage(image)),
);
---

<Base
  title={{
    cs: `${d.title_cs} | ${credentialedName}`,
    en: `${d.title_en} | ${credentialedName}`,
  }}
>
  <article class="mx-auto max-w-6xl px-6 pt-12 pb-16 sm:pt-16 sm:pb-24">
    <a href="/work/" class="text-sm text-neutral-500 hover:text-neutral-900">
      <T k="backToWork" />
    </a>

    <header class="mt-6 mb-8">
      <T
        as="h1"
        cs={d.title_cs}
        en={d.title_en}
        class="text-3xl font-medium sm:text-4xl"
      />
      <T
        as="p"
        cs={meta(d.location_cs)}
        en={meta(d.location_en)}
        class="mt-2 text-neutral-500"
      />
      {
        (d.brief_cs || d.brief_en) && (
          <T
            as="p"
            cs={d.brief_cs}
            en={d.brief_en}
            class="mt-4 max-w-prose whitespace-pre-line"
          />
        )
      }
    </header>

    <ProjectBlocks projectId={project.id} blocks={d.blocks} {responsiveImages} />
    {images.length > 0 && <Gallery {images} {responsiveImages} client:load />}
  </article>
</Base>
