---
import { pageLanguage } from '../locale';
import { bindOneLetterWords } from '../one-letter-words';
import { canSplitProse } from '../prose';

const lang = pageLanguage(Astro.url.pathname);

interface Props {
  cs?: string;
  en?: string;
  class?: string;
}

const { cs, en, class: cls } = Astro.props;
---

{
  [{ lang: 'cs', text: cs }, { lang: 'en', text: en }].filter((entry) => entry.lang === lang).map(({ lang, text }) =>
    text?.trim() && (
      <p
        {lang}
        class:list={['running-text whitespace-pre-line', cls, { 'prose-columns': canSplitProse(text) }]}
        set:text={lang === 'cs' ? bindOneLetterWords(text) : text}
      />
    ),
  )
}
