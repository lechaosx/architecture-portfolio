---
import '@fontsource-variable/roboto/index.css';
// Linked rather than imported, so the font stays out of the stylesheet Astro
// bundles for every page.
import condensed from '@fontsource-variable/roboto-condensed/wght.css?url';
import '../styles/global.css';
import { pageLanguage } from '../locale';

// A page printed to a PDF; its own `@page` rule sets the paper and margins.
interface Props {
  title: string;
  /** Where the build writes the PDF: the renderer reads it from the alternate link. */
  pdf: string;
}

const { title, pdf } = Astro.props;
const lang = pageLanguage(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} data-theme="light" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href={condensed} />
    <title>{title}</title>
    <link rel="alternate" type="application/pdf" href={pdf} />
  </head>
  <body class="h-full bg-white font-sans text-black antialiased">
    <slot />
  </body>
</html>
