---
import '@fontsource-variable/roboto/index.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { contact, home, site } from '../singletons';
import { credentialedName } from '../site-title';
import type { ImageVariant } from '../images';
import { getResponsiveImage } from '../server-images';
import { jsonLd, person } from '../structured-data';

interface Props {
  title: { cs: string; en: string };
  /** Falls back to the site description in each language. */
  description?: { cs?: string; en?: string };
  /** The JPEG link previews show. */
  image?: ImageVariant;
  type?: 'website' | 'article';
  /** schema.org nodes beside the architect's. */
  graph?: Record<string, unknown>[];
}

const { title, image, type = 'website', graph = [] } = Astro.props;
const description = {
  cs: Astro.props.description?.cs ?? site.description_cs,
  en: Astro.props.description?.en ?? site.description_en,
};
const origin = new URL('/', Astro.site);
const url = new URL(Astro.url.pathname, origin).href;
const imageUrl = image && new URL(image.url, origin).href;
const portrait = home.portrait
  ? await getResponsiveImage(home.portrait)
  : undefined;
const structuredData = jsonLd([
  person({ site: origin, owner: site, home, contact, portrait: portrait?.share.url }),
  ...graph,
]);
---

<!doctype html>
<html lang="cs" data-lang="cs" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title.cs}</title>
    <meta name="page-title" data-cs={title.cs} data-en={title.en} />
    <meta
      name="description"
      content={description.cs}
      data-cs={description.cs}
      data-en={description.en}
    />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title.cs} />
    <meta property="og:description" content={description.cs} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={credentialedName} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:locale:alternate" content="en_US" />
    {
      image && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:type" content={`image/${image.format}`} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta name="twitter:image" content={imageUrl} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <script type="application/ld+json" set:html={structuredData} />

    <!-- Pick the language and its tab title before first paint (saved >
         browser > en) so the correct-language content shows without a flash.
         It reads the page-title meta, so that must come first. -->
    <script is:inline>
      {
        let saved = null;
        try {
          saved = localStorage.getItem('lang');
        } catch {}
        const nav = (navigator.language || '').toLowerCase();
        let lang = saved || (nav.startsWith('cs') ? 'cs' : 'en');
        if (lang !== 'cs' && lang !== 'en') lang = 'en';
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
        const title = /** @type {HTMLMetaElement | null} */ (
          document.querySelector('meta[name="page-title"]')
        );
        if (title) {
          document.title = title.dataset[lang] || title.dataset.cs || document.title;
        }
      }
    </script>

    <!-- Pick the saved theme or current system preference before first paint. -->
    <script is:inline>
      {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const system = matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        document.documentElement.dataset.theme =
          saved === 'dark' || saved === 'light' ? saved : system;
      }
    </script>

    <!-- Tag cover transitions with their direction; pagereveal must be handled
         before the first frame. The opened card's hover scale is carried over
         so the opening snapshot starts where the card image was. -->
    <script is:inline>
      {
        const key = 'project-cover-scale';
        addEventListener('pageswap', (event) => {
          const swap = /** @type {PageSwapEvent} */ (event);
          if (!swap.viewTransition || !swap.activation) return;
          const url = swap.activation.entry.url;
          const link = Array.from(document.querySelectorAll('a')).find(
            (a) => a.href === url,
          );
          const cover = link?.querySelector('.project-cover');
          const image = cover?.querySelector('img');
          if (!cover || !image) return;
          try {
            sessionStorage.setItem(
              key,
              String(image.getBoundingClientRect().width / cover.clientWidth),
            );
          } catch {}
        });
        addEventListener('pagereveal', (event) => {
          let scale = null;
          try {
            scale = sessionStorage.getItem(key);
            sessionStorage.removeItem(key);
          } catch {}
          const transition = /** @type {PageRevealEvent} */ (event).viewTransition;
          if (!transition) return;
          const opening = location.pathname.startsWith('/projects/');
          transition.types.add(opening ? 'project-open' : 'project-close');
          if (opening && scale) {
            const root = document.documentElement;
            root.style.setProperty('--project-source-scale', scale);
            transition.finished.finally(() => {
              root.style.removeProperty('--project-source-scale');
            });
          }
        });
      }
    </script>
  </head>
  <body class="min-h-screen bg-white font-sans text-black antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal elements as they enter the viewport, using the real scrollbar.
      // Only elements off screen at the first observation are hidden, so
      // nothing waits on this script and nothing on screen fades in late.
      function initReveal() {
        const observer = new IntersectionObserver((entries) => {
          for (const { target, isIntersecting } of entries) {
            if (isIntersecting) {
              target.classList.remove('is-hidden');
              observer.unobserve(target);
            } else {
              target.classList.add('is-hidden');
            }
          }
        });
        document
          .querySelectorAll('.reveal')
          .forEach((element) => observer.observe(element));
      }

      function applyLang() {
        const lang = document.documentElement.dataset.lang || 'cs';
        const title = document.querySelector<HTMLMetaElement>(
          'meta[name="page-title"]',
        );
        if (title) {
          document.title =
            title.dataset[lang] || title.dataset.cs || document.title;
        }
        const description = document.querySelector<HTMLMetaElement>(
          'meta[name="description"]',
        );
        const content = description?.dataset[lang];
        if (description && content) description.content = content;
        for (const image of document.querySelectorAll<HTMLImageElement>(
          'img[data-cs], img[data-en]',
        )) {
          image.alt = image.dataset[lang] ?? '';
        }
      }

      const themeQuery = matchMedia('(prefers-color-scheme: dark)');
      themeQuery.addEventListener('change', () => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        if (saved !== 'dark' && saved !== 'light') {
          document.documentElement.dataset.theme = themeQuery.matches
            ? 'dark'
            : 'light';
        }
      });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const root = document.documentElement;
        if (event.target.closest('[data-lang-toggle]')) {
          const lang = root.dataset.lang === 'cs' ? 'en' : 'cs';
          try {
            localStorage.setItem('lang', lang);
          } catch {}
          root.dataset.lang = lang;
          root.lang = lang;
          applyLang();
        } else if (event.target.closest('[data-theme-toggle]')) {
          const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('theme', theme);
          } catch {}
          root.dataset.theme = theme;
        }
      });

      initReveal();
      applyLang();
    </script>
  </body>
</html>
