---
import { pageLanguage, routeLanguage, localizedPath, neutralPath, preferredLanguage } from '../locale';
import '@fontsource-variable/roboto/index.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { about, contact, site } from '../singletons';
import { credentialedName } from '../site-title';
import type { ImageVariant } from '../images';
import { getResponsiveImage } from '../server-images';
import { jsonLd, person } from '../structured-data';

interface Props {
  title: { cs: string; en: string };
  /** Falls back to the site description in each language. */
  description?: { cs?: string; en?: string };
  /** The JPEG link previews show. */
  image?: ImageVariant;
  type?: 'website' | 'article';
  /** Keeps the page out of search engines. */
  noindex?: boolean;
  /** schema.org nodes beside the architect's. */
  graph?: Record<string, unknown>[] | { cs: Record<string, unknown>[]; en: Record<string, unknown>[] };
}

const { title, image, type = 'website', noindex = false, graph = [] } = Astro.props;
const description = {
  cs: Astro.props.description?.cs ?? site.description_cs,
  en: Astro.props.description?.en ?? site.description_en,
};
const lang = pageLanguage(Astro.url.pathname);
const origin = new URL('/', Astro.site);
const path = neutralPath(Astro.url.pathname);
const redirect = !noindex && !routeLanguage(Astro.url.pathname);
const url = noindex ? undefined : new URL(localizedPath(path, lang), origin).href;
const imageUrl = image && new URL(image.url, origin).href;
const portrait = about.portrait
  ? await getResponsiveImage(about.portrait)
  : undefined;
const structuredData = Object.fromEntries((['cs', 'en'] as const).map((language) => [language, jsonLd([
  person({ site: origin, owner: site, about, contact, portrait: portrait?.share.url, lang: language }),
  ...(Array.isArray(graph) ? graph : graph[language]),
])]));
---

<!doctype html>
<html lang={lang} data-lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title[lang]}</title>
    <meta name="page-title" data-cs={title.cs} data-en={title.en} />
    <meta
      name="description"
      content={description[lang]}
      data-cs={description.cs}
      data-en={description.en}
    />
    {url && <link rel="canonical" href={url} />}
    {!noindex && ['cs', 'en'].map((language) => (
      <link rel="alternate" hreflang={language} href={new URL(localizedPath(path, language as 'cs' | 'en'), origin).href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(path, origin).href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title[lang]} data-cs={title.cs} data-en={title.en} />
    <meta property="og:description" content={description[lang]} data-cs={description.cs} data-en={description.en} />
    <meta property="og:type" content={type} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:site_name" content={credentialedName} />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} data-cs="cs_CZ" data-en="en_US" />
    <meta property="og:locale:alternate" content={lang === 'cs' ? 'en_US' : 'cs_CZ'} data-cs="en_US" data-en="cs_CZ" />
    {
      image && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:type" content={`image/${image.format}`} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta name="twitter:image" content={imageUrl} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <script type="application/ld+json" data-cs={structuredData.cs} data-en={structuredData.en} set:html={structuredData[lang]} />

    {redirect && <script is:inline set:html={`
      const preferredLanguage = ${preferredLanguage.toString()};
      let saved = null;
      try { saved = localStorage.getItem('lang'); } catch {}
      const language = preferredLanguage(saved, navigator.languages?.length ? navigator.languages : [navigator.language]);
      location.replace('/' + language + location.pathname + location.search + location.hash);
    `} />}

    {noindex && <script is:inline set:html={`
      const preferredLanguage = ${preferredLanguage.toString()};
      const routeLanguage = ${routeLanguage.toString()};
      let saved = null;
      try { saved = localStorage.getItem('lang'); } catch {}
      const language = routeLanguage(location.pathname) || preferredLanguage(saved, navigator.languages?.length ? navigator.languages : [navigator.language]);
      document.documentElement.lang = language;
      document.documentElement.dataset.lang = language;
      const title = document.querySelector('meta[name="page-title"]');
      if (title) document.title = title.dataset[language];
      const description = document.querySelector('meta[name="description"]');
      if (description) description.content = description.dataset[language];
    `} />}

    <!-- Pick the saved theme or current system preference before first paint. -->
    <script is:inline>
      {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const system = matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        document.documentElement.dataset.theme =
          saved === 'dark' || saved === 'light' ? saved : system;
      }
    </script>

    <!-- Tag cover transitions with their direction; pagereveal must be handled
         before the first frame. The opened card's hover scale is carried over
         so the opening snapshot starts where the card image was. -->
    <script is:inline>
      {
        const key = 'project-cover-scale';
        addEventListener('pageswap', (event) => {
          const swap = /** @type {PageSwapEvent} */ (event);
          if (!swap.viewTransition || !swap.activation) return;
          const url = swap.activation.entry.url;
          const link = Array.from(document.querySelectorAll('a')).find(
            (a) => a.href === url,
          );
          const cover = link?.querySelector('.project-cover');
          const image = cover?.querySelector('img');
          if (!cover || !image) return;
          try {
            sessionStorage.setItem(
              key,
              String(image.getBoundingClientRect().width / cover.clientWidth),
            );
          } catch {}
        });
        addEventListener('pagereveal', (event) => {
          let scale = null;
          try {
            scale = sessionStorage.getItem(key);
            sessionStorage.removeItem(key);
          } catch {}
          const transition = /** @type {PageRevealEvent} */ (event).viewTransition;
          if (!transition) return;
          const opening = /^\/(?:cs\/|en\/)?projects\//.test(location.pathname);
          transition.types.add(opening ? 'project-open' : 'project-close');
          if (opening && scale) {
            const root = document.documentElement;
            root.style.setProperty('--project-source-scale', scale);
            transition.finished.finally(() => {
              root.style.removeProperty('--project-source-scale');
            });
          }
        });
      }
    </script>
  </head>
  <body class="min-h-screen bg-white font-sans text-black antialiased">
    <Nav bilingual={noindex} />
    <main>
      <slot />
    </main>
    <Footer bilingual={noindex} />

    <script>
      // Reveal elements as they enter the viewport, using the real scrollbar.
      // Only elements off screen at the first observation are hidden, so
      // nothing waits on this script and nothing on screen fades in late.
      function initReveal() {
        const observer = new IntersectionObserver((entries) => {
          for (const { target, isIntersecting } of entries) {
            if (isIntersecting) {
              target.classList.remove('is-hidden');
              observer.unobserve(target);
            } else {
              target.classList.add('is-hidden');
            }
          }
        });
        document
          .querySelectorAll('.reveal')
          .forEach((element) => observer.observe(element));
      }

      import { initLanguageSwitch } from '../language-switch';
      initLanguageSwitch();

      const themeQuery = matchMedia('(prefers-color-scheme: dark)');
      themeQuery.addEventListener('change', () => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        if (saved !== 'dark' && saved !== 'light') {
          document.documentElement.dataset.theme = themeQuery.matches
            ? 'dark'
            : 'light';
        }
      });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const root = document.documentElement;
        if (event.target.closest('[data-theme-toggle]')) {
          const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('theme', theme);
          } catch {}
          root.dataset.theme = theme;
        }
      });

      initReveal();

    </script>
  </body>
</html>
