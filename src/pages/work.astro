---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkProjects from '../components/WorkProjects.astro';
import T from '../components/T.astro';
import { credentialedName } from '../site-title';
import { ui } from '../i18n';
import { workProjects } from '../projects';
import { getResponsiveImage } from '../server-images';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const [first] = workProjects(projects).grid;
const image = first && (await getResponsiveImage(first.cover.image))?.share;
---

<Base
  title={{ cs: `${ui.cs.work} | ${credentialedName}`, en: `${ui.en.work} | ${credentialedName}` }}
  {image}
>
  <section class="mx-auto max-w-6xl px-6 pt-12 pb-8 sm:pt-16">
    <T as="h1" k="work" class="text-3xl font-medium sm:text-4xl" />
  </section>

  <WorkProjects {projects} />
</Base>
