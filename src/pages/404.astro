---
import Base from '../layouts/Base.astro';
import PageContent from '../components/PageContent.astro';
import T from '../components/T.astro';
import { credentialedName } from '../site-title';
import { ui } from '../i18n';
---

<Base
  title={{
    cs: `${ui.cs.notFound} | ${credentialedName}`,
    en: `${ui.en.notFound} | ${credentialedName}`,
  }}
  noindex
>
  <PageContent as="section">
    <T bilingual as="h1" k="notFoundHeading" class="text-3xl font-medium sm:text-4xl" />
    <T bilingual as="p" k="notFoundLine" class="mt-4 text-neutral-600" />
    <p class="mt-6">
      <a href="/en/" data-localized-path="/" class="text-link">
        <T bilingual k="notFoundLink" />
      </a>
    </p>
  </PageContent>
</Base>
