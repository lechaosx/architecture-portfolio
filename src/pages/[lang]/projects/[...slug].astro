---
import { projects } from '../../../published-projects';
import { hasPage } from '../../../projects';
import { about, contact, site } from '../../../singletons';
import ProjectPage from '../../../components/ProjectPage.astro';

export async function getStaticPaths() {
  const pages = projects.filter(({ data }) => hasPage(data));
  return ['cs', 'en'].flatMap((lang) => pages.map((p) => ({ params: { lang, slug: p.id }, props: { project: p } })));
}

const { project } = Astro.props;
---

<ProjectPage {project} {site} {about} {contact} />
