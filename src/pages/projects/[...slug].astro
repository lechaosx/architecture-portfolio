---
import { projects } from '../../published-projects';
import { about, contact, site } from '../../singletons';
import ProjectPage from '../../components/ProjectPage.astro';

export async function getStaticPaths() {
  const pages = projects.filter(({ data }) => data.blocks.length > 0);
  return pages.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
---

<ProjectPage {project} {site} {about} {contact} />
