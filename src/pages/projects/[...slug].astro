---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.svelte';
import ProjectBlocks from '../../components/ProjectBlocks.astro';
import T from '../../components/T.astro';
import { frontmatter as site } from '../../content/singletons/site.md';
import { ui } from '../../i18n';
import {
  displayImageUrl,
  LARGE_IMAGE_WIDTHS,
  responsiveSrcset,
} from '../../images';
import { getResponsiveImage } from '../../server-images';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;

const meta = (loc?: string) => [loc, d.year].filter(Boolean).join(' · ');
const images = [
  { image: d.cover },
  ...d.blocks.flatMap((block) => (block.type === 'text' ? [] : block.images)),
];
const responsiveImages = await Promise.all(
  images.map(({ image }) => getResponsiveImage(image)),
);
const responsiveCover = responsiveImages[0];
---

<Base
  title={{
    cs: `${d.title_cs} — ${site.name}`,
    en: `${d.title_en} — ${site.name}`,
  }}
>
  <article class="mx-auto max-w-6xl px-6 pt-12 pb-16 sm:pt-16 sm:pb-24">
    <a href="/work" class="text-sm text-neutral-500 hover:text-neutral-900">
      <T k="backToWork" />
    </a>

    <header class="mt-6 mb-8">
      <T
        as="h1"
        cs={d.title_cs}
        en={d.title_en}
        class="text-3xl font-medium sm:text-4xl"
      />
      <T
        as="p"
        cs={meta(d.location_cs)}
        en={meta(d.location_en)}
        class="mt-2 text-neutral-500"
      />
    </header>

    <button
      type="button"
      data-lightbox-index={0}
      class="group block w-full overflow-hidden bg-neutral-100"
    >
      <span lang="cs" class="sr-only">
        {ui.cs.openImage} 1
      </span>
      <span lang="en" class="sr-only">
        {ui.en.openImage} 1
      </span>
      <img
        src={displayImageUrl(responsiveCover, d.cover)}
        srcset={responsiveSrcset(responsiveCover, LARGE_IMAGE_WIDTHS)}
        sizes="(min-width: 1152px) 1104px, calc(100vw - 48px)"
        width={responsiveCover?.source.width}
        height={responsiveCover?.source.height}
        alt=""
        class="project-cover w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        style={`view-transition-name: cover-${project.id}`}
      />
    </button>

    <ProjectBlocks blocks={d.blocks} {responsiveImages} />
    <Gallery {images} {responsiveImages} client:load />
  </article>
</Base>
