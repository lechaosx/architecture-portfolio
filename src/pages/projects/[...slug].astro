---
import { getCollection } from 'astro:content';
import ProjectPage from '../../components/ProjectPage.astro';
import { projectPages } from '../../projects';
import { contact } from '../../singletons';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projectPages(projects).map((page) => ({ params: { slug: page.project.id }, props: page }));
}

const { project, previous, next } = Astro.props;
---

<ProjectPage {project} {previous} {next} {contact} />
