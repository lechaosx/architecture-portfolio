{
  "name": "architect-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "images": "flock node_modules/.images.lock node scripts/generate-responsive-images.ts",
    "predev": "npm run images",
    "dev": "astro dev",
    "start": "npm run dev",
    "check": "astro check --minimumFailingSeverity hint",
    "test": "vitest run",
    "pretest:e2e": "E2E_FIXTURES=1 npm run build",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test && npm run test:e2e",
    "prebuild": "npm run images",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/roboto": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "marked": "^18.0.14",
    "openseadragon": "^6.1.1",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
