{
  "name": "architect-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "images": "flock node_modules/.images.lock bun scripts/generate-responsive-images.ts",
    "predev": "bun run images",
    "dev": "astro dev",
    "start": "bun run dev",
    "check": "astro check --minimumFailingSeverity hint",
    "test": "bun test --path-ignore-patterns 'tests/e2e/**'",
    "pretest:e2e": "bun run build",
    "test:e2e": "playwright test",
    "test:all": "bun run check && bun run test && bun run test:e2e",
    "prebuild": "bun run images",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/roboto": "^5.2.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "~7.0.9",
    "marked": "^18.0.6",
    "openseadragon": "^6.1.1",
    "svelte": "^5.56.4",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.60.0",
    "@types/bun": "^1.4.2",
    "sharp": "^0.34.5",
    "typescript": "^6.0.0"
  }
}
