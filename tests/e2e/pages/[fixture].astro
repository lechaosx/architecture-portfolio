---
// Pages the browser tests run against, so they do not depend on the shipped
// content; astro.config.e2e.mjs adds them at /e2e/. Their images are
// tests/e2e/images, served by images/[file].ts.
import { about as frameAbout, contact as frameContact, site } from '../architect';
import { thumbnailProjects } from '../thumbnail-projects';
import type { CollectionEntry } from 'astro:content';
import { projectCard, type Project } from '../../../src/projects';
import Base from '../../../src/layouts/Base.astro';
import AboutPage from '../../../src/components/AboutPage.astro';
import LegalPage from '../../../src/components/LegalPage.astro';
import LandingPage from '../../../src/components/LandingPage.astro';
import ProjectBlocks from '../../../src/components/ProjectBlocks.astro';
import ProjectPage from '../../../src/components/ProjectPage.astro';
import Paragraphs from '../../../src/components/Paragraphs.astro';
import WorkPage from '../../../src/components/WorkPage.astro';

export function getStaticPaths() {
  const images = [
    '/e2e/images/placeholder-cover.svg',
    '/e2e/images/placeholder-1.svg',
    '/e2e/images/placeholder-2.svg',
  ];

  const sentence = {
    en: 'The drawing follows how a square, a park and a stadium meet along a river, and where a new path could join them.',
    cs: 'Výkres sleduje, jak se náměstí, park a stadion potkávají podél řeky a kudy by je mohla spojit nová cesta.',
  };
  const text = (sentences: number) => ({
    en: Array(sentences).fill(sentence.en).join(' '),
    cs: Array(sentences).fill(sentence.cs).join(' '),
  });
  const words = (count: number) => ({
    cs: text(100).cs.split(/\s+/).slice(0, count).join(' '),
    en: text(100).en.split(/\s+/).slice(0, count).join(' '),
  });
  const described = (sentences: number) => ({ description: text(sentences) });
  const short = {
    description: { cs: 'Krátká poznámka.', en: 'A short note.' },
  };
  const tiled = { comparison_set: 'tiled' };
  const untiled = { comparison_set: 'untiled' };
  const item = (file: string, title?: [en: string, cs: string], more = {}) => ({
    image: `/e2e/images/${file}`,
    ...(title && { title: { cs: title[1], en: title[0] } }),
    ...more,
  });
  // Each title ends in its image's lightbox position.
  const project: CollectionEntry<'projects'>['data'] = {
    title: { cs: 'Testovací projekt', en: 'Test project' },
    from: '3/2025',
    to: '6/2026',
    location: { cs: 'Nikde', en: 'Nowhere' },
    draft: false,
    context: [], intervention: [], scope: [], design_in_progress: false, role: [], collaborators: [],
    blocks: [
      { type: 'image_set', images: [item('cover.png')] },
      { type: 'text', body: { cs: text(6).cs, en: text(6).en } },
      {
        type: 'gallery',
        images: [
          // All tiled, since a set zooms only as far as its least detailed
          // image allows. Its titles are long enough for a phone's set strip
          // to centre the second.
          item('tiled-1.png', ['Tiled variant 2', 'Dlaždicová varianta 2'], { ...tiled, ...described(8) }),
          item('tiled-2.png', ['Tiled variant 3', 'Dlaždicová varianta 3'], { ...tiled, ...described(24) }),
          item('tiled-3.png', ['Tiled variant 4', 'Dlaždicová varianta 4'], { ...tiled, ...described(8) }),
          item('tiled-4.png', ['Tiled variant 5', 'Dlaždicová varianta 5'], { ...tiled, ...described(8) }),
          item('tiled-5.png', ['Tiled variant 6', 'Dlaždicová varianta 6'], { ...tiled, ...described(8) }),
          item('square-1.png', ['Drawing 7', 'Výkres 7'], described(8)),
          item('tiled-1.png', ['Drawing 8', 'Výkres 8'], described(24)),
          item('tiled-3.png', ['Drawing 9', 'Výkres 9'], described(8)),
          item('square-2.png', ['Drawing 10', 'Výkres 10']),
          item('wide.png', ['View 11', 'Pohled 11']),
          item('wide.png', ['View 12', 'Pohled 12'], described(24)),
          item('wide.png', ['View 13', 'Pohled 13']),
          item('wide.png', ['View 14', 'Pohled 14']),
          item('wide.png', ['View 15', 'Pohled 15']),
          item('wide.png', ['View 16', 'Pohled 16']),
          // An SVG has no responsive variants.
          item('vector.svg', ['Vector 17', 'Vektor 17'], short),
        ],
      },
      {
        type: 'gallery',
        images: [
          item('untiled-1.png', ['Untiled variant 18', 'Varianta bez dlaždic 18'], { ...untiled, ...short }),
          item('untiled-2.png', ['Untiled variant 19', 'Varianta bez dlaždic 19'], untiled),
          item('untiled-3.png', ['Untiled variant 20', 'Varianta bez dlaždic 20'], untiled),
          item('wide.png'),
        ],
      },
      { type: 'image_set', images: [item('wide.png')] },
      { type: 'gallery', images: [item('square-1.png'), item('cover.png')] },
    ],
  };

  const projectWith = (id: string, blocks: typeof project.blocks, more = {}) => ({
    params: { fixture: id },
    props: { project: { id: `e2e-${id}`, data: { ...project, blocks, ...more } } },
  });

  const listed = (id: string, data: Partial<typeof project>) => ({
    id: `e2e-${id}`,
    data: { ...project, ...data },
  });
  const gridProject = listed('grid', {
    title: { ...project.title, en: 'Grid project' },
    from: '2025',
    to: undefined,
    blocks: [{ type: 'image_set', images: [item('wide.png')] }],
  });
  const alphaProject = listed('alpha', {
    title: { ...project.title, en: 'Alpha brief' },
    from: '2025',
    to: '2025',
    blocks: [],
    location: { cs: 'Nikde', en: 'Prague' },
    brief: { cs: 'První řádek\nDruhý řádek', en: 'First line\nSecond line' },
  });
  // Out of order, so the list's sort shows. Old brief has a period as wide as any.
  const briefProjects = [
    listed('old', { title: { ...project.title, en: 'Old brief' }, from: '12/2019', to: '12/2020', blocks: [] }),
    listed('text-only', {
      title: { ...project.title, en: 'Beta text' },
      from: '2025',
      to: '2025',
      blocks: [{ type: 'text', body: { cs: text(1).cs, en: text(1).en } }],
      brief: { cs: 'Textový projekt.', en: 'A text project.' },
    }),
    gridProject,
    alphaProject,
  ];

  const myRoles = [
    { cs: 'Návrh interiéru', en: 'Interior design' },
    { cs: 'Dokumentace', en: 'Documentation' },
    { cs: 'Autorský dozor', en: 'Site supervision' },
  ];
  // Every credit, one collaborator without a role, and an award.
  const credits: Partial<typeof project> = {
    context: ['academic', 'competition'],
    design_in_progress: true,
    realization: 'planned',
    intervention: ['renovation', 'extension'],
    scope: ['architecture', 'interior'],
    studio: 'Studio North | Ing. arch. Jana Nováková',
    collaborators: [
      { name: 'Jan Novák', role: { cs: 'Autor návrhu · koordinace', en: 'Design author · Coordination' } },
      { name: 'Eva Dvořáková', role: { cs: 'Autor návrhu', en: 'Design author' } },
      { name: 'Ing. Petr Malý', role: { cs: 'vizualizace', en: 'Visualizations' } },
      { name: 'Ing. Pavel Velký', role: { cs: 'statika', en: 'Structural design' } },
      { name: 'Ing. Iva Tichá' },
    ],
    award: { cs: 'Odměna za dílčí podnět', en: 'Special mention' },
  };
  const badgeProject = listed('badges-only', { title: { cs: 'Pouze štítky', en: 'Badges only' }, from: '2023', to: '2023', blocks: [], context: ['self_initiated', 'commissioned'] });
  const creditProjects = [
    { ...alphaProject, data: { ...alphaProject.data, ...credits } },
    listed('credits-only', {
      title: { ...project.title, en: 'Credits only' },
      from: '2024',
      to: '2024',
      blocks: [],
      studio: credits.studio,
    }),
  ];

  creditProjects.push(badgeProject);

  const service = (en: string, cs: string) => ({ name: { cs, en } });
  // Pages CMS writes one typed line break as a single newline, two as a blank line.
  const approach = {
    label: { cs: 'Místo', en: 'Place' },
    text: { cs: 'První odstavec.\nDruhý odstavec.', en: 'First paragraph.\n\nSecond paragraph.' },
  };
  const about: CollectionEntry<'about'>['data'] = {
    portrait: '/e2e/images/square-1.png',
    bio: { cs: text(2).cs, en: text(2).en },
    approaches: (['place', 'scale', 'material', 'thinking'] as const).map((icon) => ({ ...approach, icon })),
    experience: [
      {
        place: { cs: 'Ateliér A, Brno', en: 'Studio A, Brno' },
        department: { cs: 'Tým bydlení', en: 'Housing team' },
        from: '2024',
        title: { cs: 'Architektka', en: 'Architect' },
        description: { cs: `${text(2).cs}\nVýkresy k povolení.`, en: `${text(2).en}\n\nPermit drawings.` },
      },
      {
        place: { cs: 'Ateliér B, Praha', en: 'Studio B, Prague' },
        from: '2022',
        to: '2024',
        title: { cs: 'Stážistka', en: 'Intern' },
      },
    ],
    services: [service('Family houses', 'Rodinné domy'), service('Renovations', 'Rekonstrukce'), service('Interiors', 'Interiéry')],
    education: [
      {
        place: { cs: 'Fakulta stavební VUT v Brně', en: 'Faculty of Civil Engineering, Brno University of Technology' },
        department: { cs: 'Ústav architektury', en: 'Institute of Architecture' },
        from: '12/2024',
        to: '12/2026',
        title: { cs: 'Architektura a rozvoj sídel', en: 'Architecture and Urban Development' },
        degree: 'Ing. arch.',
      },
    ],
    awards: [
      {
        place: { cs: 'Mladý architekt', en: 'Young architect' },
        title: { cs: '2. místo', en: '2nd place' },
        description: { cs: sentence.cs, en: sentence.en },
      },
    ],
  };
  // Some longer than a phone's line.
  const longServices = [
    service('Architectural studies', 'Architektonické studie'),
    service('Documentation for the building permit', 'Projektová dokumentace pro povolení stavby'),
    service('Permitting and dealing with the authorities', 'Povolovací proces a jednání s úřady'),
    service('Interior design', 'Návrhy interiérů'),
    service('Coordination of disciplines (BIM)', 'Koordinace profesí (BIM)'),
  ];
  // Nothing optional filled.
  const bareAbout = { ...about, portrait: undefined, approaches: [], experience: [], services: [], education: [], awards: [] };
  const bareContact = { email: frameContact.email };

  const cards = (projects: Project[]) => projects.flatMap((project) => projectCard(project) ?? []);
  const [project2025, project2024, project2023] = [2025, 2024, 2023].map((year) =>
    listed(String(year), {
      title: { cs: `Projekt ${year}`, en: `Project ${year}` },
      from: String(year),
      to: String(year),
      blocks: [{ type: 'image_set', images: [item('square-1.png')] }],
    }),
  );
  // Out of date order, and more than one row.
  const chosen = cards([project2024, gridProject, project2023, project2025]);
  const landing = (heroImages: string[], projects = chosen) => ({
    landing: { images: heroImages, projects },
    ...(heroImages.length > 0 ? { about, contact: frameContact } : { about: bareAbout, contact: bareContact }),
  });

  const paths = [
    { params: { fixture: 'thumbnail-work' }, props: { projects: thumbnailProjects } },
    { params: { fixture: 'thumbnail-landing' }, props: landing([], cards(thumbnailProjects)) },
    { params: { fixture: 'landing' }, props: landing([images[0], '/e2e/images/wide.png', '/e2e/images/cover.png']) },
    { params: { fixture: 'landing-single' }, props: landing(images.slice(0, 1)) },
    { params: { fixture: 'landing-bare' }, props: landing([]) },
    { params: { fixture: 'landing-no-work' }, props: landing([], []) },
    { params: { fixture: 'landing-long-services' }, props: { ...landing([]), contact: frameContact, about: { ...about, services: longServices } } },
    { params: { fixture: 'about' }, props: { about } },
    { params: { fixture: 'about-tall-portrait' }, props: { about: { ...about, portrait: '/e2e/images/tall.png' } } },
    { params: { fixture: 'language-height' }, props: { about: { ...about, bio: { cs: text(2).cs, en: Array(20).fill(text(4).en).join('\n\n') } } } },
    { params: { fixture: 'about-bare' }, props: { about: bareAbout } },
    { params: { fixture: 'about-long-services' }, props: { about: { ...about, services: longServices } } },
    { params: { fixture: 'legal' }, props: { legal: true } },
    { params: { fixture: 'legal-bare' }, props: { legal: true, contact: bareContact } },
    { params: { fixture: 'legal-seat' }, props: { legal: true, contact: { ...bareContact, seat: frameContact.seat } } },
    { params: { fixture: 'about-long-bare' }, props: { about: { ...bareAbout, bio: { cs: words(150).cs, en: words(150).en } } } },
    { params: { fixture: 'work' }, props: { projects: briefProjects } },
    { params: { fixture: 'work-grid-only' }, props: { projects: [gridProject] } },
    { params: { fixture: 'work-list-only' }, props: { projects: briefProjects.filter((p) => p !== gridProject) } },
    { params: { fixture: 'work-credits' }, props: { projects: creditProjects } },
    { params: { fixture: 'work-project-link' }, props: { projects: [listed('link-only', { title: { cs: 'Externí projekt', en: 'External project' }, blocks: [], project_url: 'https://architecture-and-urban-design.example.org/projects/library?view=plan#drawings' })] } },
    { params: { fixture: 'work-role-only' }, props: { projects: [listed('role-only', {
      title: { cs: 'Pouze moje role', en: 'My role only' }, blocks: [],
      role: myRoles,
    })] } },
    projectWith('project-role', project.blocks.slice(0, 1), {
      brief: { cs: 'Knihovna s veřejnou zahradou. Navrhla jsem její interiér.', en: 'A library with a public garden. I designed its interior.' },
      role: myRoles,
      studio: 'Studio North',
      collaborators: [{ name: 'Jan Novák', role: { cs: 'Statika', en: 'Structural design' } }],
    }),
    projectWith('project-link', project.blocks.slice(0, 1), { project_url: 'https://architecture-and-urban-design.example.org/projects/library?view=plan#drawings' }),
    { params: { fixture: 'paragraphs-length' }, props: { paragraphs: { cs: `${words(75).cs}\n${words(74).cs}`, en: `${words(75).en}\n${words(75).en}` } } },
    projectWith('brief-length', project.blocks.slice(0, 1), { brief: { cs: words(149).cs, en: words(150).en } }),
    projectWith('prose-long', [{ type: 'image_set', images: [item('wide.png')] }, { type: 'text', body: { cs: words(150).cs, en: words(150).en } }]),
    projectWith('prose-length', [
      { type: 'text', body: { cs: words(149).cs, en: words(149).en } },
      { type: 'text', body: { cs: words(150).cs, en: words(150).en } },
      { type: 'text', body: { cs: `${words(149).cs} ![${words(150).cs}](/e2e/images/placeholder-1.svg)`, en: `${words(149).en} ![${words(150).en}](/e2e/images/placeholder-1.svg)` } },
    ]),
    projectWith('brief', project.blocks.slice(0, 1), {
      brief: { cs: 'Anotace stránky.\nDruhý řádek.', en: 'A brief for the page.\nSecond line.' },
    }),
    projectWith('credits', project.blocks.slice(0, 1), {
      brief: { cs: text(2).cs, en: text(2).en },
      ...credits,
    }),
    projectWith('credits-no-brief', project.blocks.slice(0, 1), credits),
    projectWith('text-only', [{ type: 'text', body: { cs: text(2).cs, en: text(2).en } }]),
    projectWith('vector-only', [{ type: 'gallery', images: [item('vector.svg')] }]),
    projectWith('náměstí', [{ type: 'image_set', images: [item('wide.png')] }]),
    // A soft line break, emphasis and an image in the rich text.
    projectWith('markdown', [
      {
        type: 'text',
        body: { cs: 'Plán v\nparku a **v Brně**.\n\n![Plán v parku](/e2e/images/placeholder-1.svg)', en: 'A plan in a park\nand a **view**.\n\n![A plan](/e2e/images/placeholder-1.svg)' },
      },
    ]),
    projectWith('titled-sets', [
      { type: 'image_set', images: [item('wide.png', ['Plan', 'Půdorys'])] },
      {
        type: 'image_set',
        images: [item('cover.png', ['Section', 'Řez']), item('wide.png')],
      },
    ]),
    // A text block first, so the page's first image is not at its top.
    projectWith('text-first', [
      { type: 'text', body: { cs: text(2).cs, en: text(2).en } },
      { type: 'image_set', images: [item('wide.png')] },
    ]),
    projectWith('set-first', [
      { type: 'image_set', images: [item('wide.png'), item('cover.png')] },
    ]),
    projectWith('carousel-lightbox', [
      { type: 'image_set', images: images.map((image) => ({ image })) },
    ]),
    projectWith('gallery-first', [
      { type: 'gallery', images: [item('square-1.png'), item('square-2.png')] },
    ]),
    { params: { fixture: 'carousel' }, props: { images } },
    {
      params: { fixture: 'carousel-long' },
      props: {
        images: Array.from({ length: 18 }, (_, index) =>
          `${images[index % images.length]}?slide=${index}`,
        ),
      },
    },
    { params: { fixture: 'project' }, props: { project: { id: 'e2e-project', data: project } } },
  ];
  // Each page's frame shows About and contact data: ../architect.ts's unless
  // the page brings its own.
  return paths.map((path) => ({ ...path, props: { about: frameAbout, contact: frameContact, ...path.props } }));
}

const { about, contact, images, landing, legal, paragraphs, project, projects } = Astro.props;
---

{
  paragraphs ? (
    <Base title={{ cs: 'Text', en: 'Text' }} {site} {about} {contact}>
      <div class="mx-auto max-w-6xl px-6 pt-12"><Paragraphs {...paragraphs} class="space-y-4" /></div>
    </Base>
  ) : legal ? (
    <LegalPage {site} {about} {contact} />
  ) : project ? (
    <ProjectPage {project} {site} {about} {contact} />
  ) : landing ? (
    <LandingPage {landing} {site} {about} {contact} />
  ) : projects ? (
    <WorkPage {projects} {site} {about} {contact} />
  ) : images ? (
    <Base title={{ cs: 'E2E', en: 'E2E' }} {site} {about} {contact}>
      <div class="mx-auto max-w-6xl px-6 pb-16">
        <ProjectBlocks
          projectId="e2e"
          project={{ title: { cs: 'E2E', en: 'E2E' } }}
          blocks={[
            { type: 'image_set', images: images.map((image) => ({ image })) },
          ]}
          responsiveImages={[]}
        />
      </div>
    </Base>
  ) : (
    <AboutPage {site} {about} {contact} />
  )
}
