---
import ProjectPage from '../../../src/components/ProjectPage.astro';
import { hasPage } from '../../../src/projects';
import { about, contact, cv, site } from '../architect';
import { thumbnailProjects } from '../thumbnail-projects';

export function getStaticPaths() {
  return thumbnailProjects.filter(({ data }) => hasPage(data)).map((project) => ({
    params: { fixture: project.id.replace('e2e-thumbnail-', '') }, props: { project },
  }));
}

const { project } = Astro.props;
---
<ProjectPage {project} {site} {about} {contact} {cv} />
